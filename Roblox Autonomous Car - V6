local function updateVelocityYaw()
	if not primary or not primary.Parent then
		vehicle.cuVelYawValid = false
		return
	end

	local vel = primary.AssemblyLinearVelocity
	local hs = horizontalSpeed(vel)
	if hs < 2.0 then
		vehicle.cuVelYawValid = false
		return
	end

	local vy = math_deg(math_atan2(vel.X, vel.Z))
	if vehicle.cuVelYawValid then
		vehicle.cuVelYaw = vehicle.cuVelYaw + wrapDeg(vy - vehicle.cuVelYaw) * 0.15
	else
		vehicle.cuVelYaw = vy
	end
	vehicle.cuVelYawValid = true
end

local function getYawCompensation()
	if not vehicle.cuVelYawValid or not primary or not primary.Parent then
		return 0
	end
	return clamp(wrapDeg(vehicle.cuVelYaw - getYawDeg(primary.CFrame)), -15, 15)
end

local function getDynamicClearMin()
	local spd = math_abs(vehicle.speedCurrent)
	local brakeDist = (spd * spd) / (2 * math_max(CONFIG.SPEED_DECEL, 1))
	local dynamic = CONFIG.AVOID_CLEAR_MIN + brakeDist * CONFIG.DYNAMIC_CLEAR_BRAKE_FACTOR
	return math_min(dynamic, CONFIG.AVOID_CLEAR_MIN * CONFIG.DYNAMIC_CLEAR_CAP_MULT)
end

--==================================================
-- LANE SENSOR
--==================================================
local LaneSensor = {}
LaneSensor.__index = LaneSensor

local function median4(a, b, c, d)
	if a > b then a, b = b, a end
	if c > d then c, d = d, c end
	if a > c then a, c = c, a end
	if b > d then b, d = d, b end
	if b > c then b, c = c, b end
	return (b + c) * 0.5
end

function LaneSensor.new(part)
	local self = setmetatable({}, LaneSensor)
	self.part = part
	self.beams = {}

	for i = 1, CONFIG.LANE_DETECTION_RAYS do
		local t = (i - 1) / math_max(CONFIG.LANE_DETECTION_RAYS - 1, 1)
		local angle = -CONFIG.LANE_SCAN_HALF_ANGLE + t * (CONFIG.LANE_SCAN_HALF_ANGLE * 2)

		self.beams[i] = {
			angle = angle,
			localVec = CFrame.Angles(0, math_rad(angle), 0) * Vector3.new(0, 0, -CONFIG.LANE_RAY_LENGTH),
			h1 = math_huge,
			h2 = math_huge,
			h3 = math_huge,
			h4 = math_huge,
			valid = false,
			dist = math_huge,
			visual = createVisual(CONFIG.LANE_RAY_LENGTH, 0.06),
		}
	end

	return self
end

function LaneSensor:scan()
	if not self.part or not self.part.Parent then
		return {
			count = 0,
			forwardAvg = math_huge,
			closest = math_huge,
			detected = false,
		}
	end

	local pos = self.part.Position
	local ori = self.part.CFrame
	local count = 0
	local sumForward = 0
	local forwardCount = 0
	local closest = math_huge

	for i = 1, #self.beams do
		local b = self.beams[i]
		local worldDir = ori:VectorToWorldSpace(b.localVec + Vector3.new(0, -CONFIG.LANE_RAY_LENGTH * 0.35, 0))
		local r = Workspace:Raycast(pos, worldDir, laneRayParams)

		local hitDist = math_huge
		local ok = false

		if r and r.Instance and r.Instance:IsA("BasePart") then
			local classId = classifyInstance(r.Instance)
			if isLaneMarkerClass(classId) then
				hitDist = (r.Position - pos).Magnitude
				ok = true
			else
				local col = r.Instance.Color
				if col.R >= 0.8 and col.G >= 0.8 and col.B >= 0.8 then
					hitDist = (r.Position - pos).Magnitude
					ok = true
				end
			end
		end

		b.h1, b.h2, b.h3, b.h4 = b.h2, b.h3, b.h4, (ok and hitDist or math_huge)

		local finiteCount = 0
		if b.h1 < math_huge then finiteCount = finiteCount + 1 end
		if b.h2 < math_huge then finiteCount = finiteCount + 1 end
		if b.h3 < math_huge then finiteCount = finiteCount + 1 end
		if b.h4 < math_huge then finiteCount = finiteCount + 1 end

		if finiteCount >= 2 then
			local d = median4(b.h1, b.h2, b.h3, b.h4)
			b.valid = d < math_huge
			b.dist = d
		else
			b.valid = false
			b.dist = math_huge
		end

		if b.valid then
			count = count + 1
			if math_abs(b.angle) < 30 then
				sumForward = sumForward + b.dist
				forwardCount = forwardCount + 1
			end
			closest = math_min(closest, b.dist)
		end

		if b.visual then
			updateVisual(b.visual, pos, pos + worldDir, ok and Color3.new(0, 1, 1) or Color3.new(1, 0, 0))
		end
	end

	return {
		count = count,
		forwardAvg = forwardCount > 0 and (sumForward / forwardCount) or math_huge,
		closest = closest,
		detected = count > 0,
	}
end

function LaneSensor:destroy()
	for _, b in ipairs(self.beams) do
		if b.visual then
			b.visual:Destroy()
		end
	end
end

--==================================================
-- CENTER LANE SENSOR
--==================================================
local CenterLaneSensor = {}
CenterLaneSensor.__index = CenterLaneSensor

local function cuIsLaneHit(r)
	if not r or not r.Instance or not r.Instance:IsA("BasePart") then
		return false
	end

	local classId = classifyInstance(r.Instance)
	if isLaneMarkerClass(classId) then
		return true
	end

	local col = r.Instance.Color
	return col.R >= 0.8 and col.G >= 0.8 and col.B >= 0.8
end

function CenterLaneSensor.new(part)
	local self = setmetatable({}, CenterLaneSensor)
	self.part = part
	self.leftVisuals = {}
	self.rightVisuals = {}

	for i = 1, CONFIG.CU_RAYS_PER_SIDE do
		self.leftVisuals[i] = createVisual(CONFIG.CU_LATERAL_MAX, 0.05)
		self.rightVisuals[i] = createVisual(CONFIG.CU_LATERAL_MAX, 0.05)
	end

	self.heightProbeVisual = createVisual(CONFIG.CU_MAX_HEIGHT, 0.08)
	self.leftDistRing = RingBuffer.new(CONFIG.CU_HISTORY_SIZE)
	self.rightDistRing = RingBuffer.new(CONFIG.CU_HISTORY_SIZE)

	return self
end

function CenterLaneSensor:probeHeight()
	if not self.part or not self.part.Parent then
		return
	end

	local pos = self.part.Position
	local downDir = Vector3.new(0, -CONFIG.CU_MAX_HEIGHT, 0)
	local r = Workspace:Raycast(pos, downDir, cuRayParams)

	if r then
		vehicle.cuGroundHeight = clamp((pos - r.Position).Magnitude, CONFIG.CU_MIN_HEIGHT, CONFIG.CU_MAX_HEIGHT)
		if self.heightProbeVisual then
			updateVisual(self.heightProbeVisual, pos, r.Position, Color3.new(1, 0, 1))
		end
	else
		if self.heightProbeVisual then
			updateVisual(self.heightProbeVisual, pos, pos + downDir, Color3.new(0.4, 0, 0.4))
		end
	end

	vehicle.cuLastHeightProbeT = now()
end

function CenterLaneSensor:scan()
	if not self.part or not self.part.Parent then
		vehicle.roadBoundsValid = false
		return {
			valid = false,
			lateralError = 0,
			leftDist = math_huge,
			rightDist = math_huge,
			confidence = 0,
			leftDetected = false,
			rightDetected = false,
		}
	end

	if (now() - vehicle.cuLastHeightProbeT) >= CONFIG.CU_HEIGHT_PROBE_INTERVAL then
		self:probeHeight()
	end

	local pos = self.part.Position
	local ori = self.part.CFrame
	local height = vehicle.cuGroundHeight

	local bestL = math_huge
	local leftFound = false

	for i = 1, CONFIG.CU_RAYS_PER_SIDE do
		local t = (i - 1) / math_max(CONFIG.CU_RAYS_PER_SIDE - 1, 1)
		local lateral = CONFIG.CU_LATERAL_MIN + t * (CONFIG.CU_LATERAL_MAX - CONFIG.CU_LATERAL_MIN)
		local worldTarget = ori:PointToWorldSpace(Vector3.new(-lateral, -height, 0))
		local worldDir = worldTarget - pos

		if worldDir.Magnitude >= 0.1 then
			local r = Workspace:Raycast(pos, worldDir, cuRayParams)
			local hit = cuIsLaneHit(r)

			if hit then
				local absLat = math_abs(ori:PointToObjectSpace(r.Position).X)
				if absLat < bestL then
					bestL = absLat
					leftFound = true
				end
			end

			if self.leftVisuals[i] then
				updateVisual(self.leftVisuals[i], pos, r and r.Position or worldTarget, hit and Color3.new(0.2, 1, 0.5) or Color3.new(0.25, 0.25, 0.25))
			end
		end
	end

	local bestR = math_huge
	local rightFound = false

	for i = 1, CONFIG.CU_RAYS_PER_SIDE do
		local t = (i - 1) / math_max(CONFIG.CU_RAYS_PER_SIDE - 1, 1)
		local lateral = CONFIG.CU_LATERAL_MIN + t * (CONFIG.CU_LATERAL_MAX - CONFIG.CU_LATERAL_MIN)
		local worldTarget = ori:PointToWorldSpace(Vector3.new(lateral, -height, 0))
		local worldDir = worldTarget - pos

		if worldDir.Magnitude >= 0.1 then
			local r = Workspace:Raycast(pos, worldDir, cuRayParams)
			local hit = cuIsLaneHit(r)

			if hit then
				local absLat = math_abs(ori:PointToObjectSpace(r.Position).X)
				if absLat < bestR then
					bestR = absLat
					rightFound = true
				end
			end

			if self.rightVisuals[i] then
				updateVisual(self.rightVisuals[i], pos, r and r.Position or worldTarget, hit and Color3.new(0.5, 1, 0.2) or Color3.new(0.25, 0.25, 0.25))
			end
		end
	end

	if leftFound then
		self.leftDistRing:push(bestL)
	else
		self.leftDistRing:decayOne()
	end

	if rightFound then
		self.rightDistRing:push(bestR)
	else
		self.rightDistRing:decayOne()
	end

	local leftMed = (self.leftDistRing:getCount() >= CONFIG.CU_MIN_VALID_FRAMES) and self.leftDistRing:getMedian() or nil
	local rightMed = (self.rightDistRing:getCount() >= CONFIG.CU_MIN_VALID_FRAMES) and self.rightDistRing:getMedian() or nil

	local leftValid = leftMed ~= nil
	local rightValid = rightMed ~= nil

	if leftValid then vehicle.roadLeftDist = leftMed end
	if rightValid then vehicle.roadRightDist = rightMed end
	vehicle.roadBoundsValid = leftValid or rightValid

	local lateralError = 0
	local confidence = 0

	if leftValid and rightValid then
		lateralError = (leftMed - rightMed) * 0.5

		local totalWidth = leftMed + rightMed
		if totalWidth >= 4 and totalWidth <= 28 then
			confidence = 1
		elseif totalWidth > 28 then
			confidence = clamp(1 - (totalWidth - 28) / 10, 0.1, 1)
		else
			confidence = 0.25
		end

		local ratio = math_min(leftMed, rightMed) / math_max(leftMed, rightMed)
		if ratio < 0.25 then
			confidence = confidence * 0.5
		end
	elseif leftValid then
		lateralError = (leftMed - CONFIG.IDEAL_LANE_DISTANCE) * 0.30
		confidence = 0.30
	elseif rightValid then
		lateralError = (CONFIG.IDEAL_LANE_DISTANCE - rightMed) * 0.30
		confidence = 0.30
	end

	if leftValid and rightValid then
		local yawComp = getYawCompensation()
		if math_abs(yawComp) > 0.5 then
			lateralError = lateralError - (leftMed + rightMed) * 0.5 * math.sin(math_rad(yawComp))
		end
	end

	return {
		valid = leftValid or rightValid,
		lateralError = lateralError,
		leftDist = leftValid and leftMed or math_huge,
		rightDist = rightValid and rightMed or math_huge,
		confidence = confidence,
		leftDetected = leftValid,
		rightDetected = rightValid,
	}
end

function CenterLaneSensor:destroy()
	for _, v in ipairs(self.leftVisuals) do
		if v then v:Destroy() end
	end
	for _, v in ipairs(self.rightVisuals) do
		if v then v:Destroy() end
	end
	if self.heightProbeVisual then
		self.heightProbeVisual:Destroy()
	end
end

--==================================================
-- CENTER LANE CONTROL
--==================================================
local function computeCenterLaneSteer(cuScan, dt)
	if not vehicle.cuActive or not cuScan.valid then
		vehicle.cuValidFrames = math_max(0, vehicle.cuValidFrames - 1)
		vehicle.cuConfidence = ema(vehicle.cuConfidence, 0, 0.10)
		vehicle.cuFilteredError = vehicle.cuFilteredError * 0.95
		vehicle.cuFilteredDeriv = vehicle.cuFilteredDeriv * 0.90
		vehicle.cuIntegral = vehicle.cuIntegral * 0.92
		vehicle.cuSmoothedSteer = smoothLerp(vehicle.cuSmoothedSteer, 0, 0.06)
		vehicle.cuPrevOutputSteer = vehicle.cuSmoothedSteer
		return vehicle.cuSmoothedSteer, vehicle.cuConfidence
	end

	vehicle.cuValidFrames = math_min(vehicle.cuValidFrames + 1, 60)
	vehicle.cuConfidence = ema(vehicle.cuConfidence, cuScan.confidence, 0.10)

	if vehicle.cuValidFrames < CONFIG.CU_MIN_VALID_FRAMES then
		vehicle.cuSmoothedSteer = smoothLerp(vehicle.cuSmoothedSteer, 0, 0.06)
		vehicle.cuPrevOutputSteer = vehicle.cuSmoothedSteer
		return vehicle.cuSmoothedSteer, vehicle.cuConfidence * 0.3
	end

	local raw = cuScan.lateralError
	vehicle.cuRawError = raw

	local changeRate = 0
	if dt > 0 then
		changeRate = math_abs(raw - vehicle.cuFilteredError) / dt
	end

	local alpha = CONFIG.CU_ERROR_FILTER_SLOW
		+ (CONFIG.CU_ERROR_FILTER_FAST - CONFIG.CU_ERROR_FILTER_SLOW)
		* clamp(changeRate / CONFIG.CU_ERROR_CHANGE_THRESHOLD, 0, 1)

	vehicle.cuFilteredError = ema(vehicle.cuFilteredError, raw, alpha)
	local err = vehicle.cuFilteredError

	if math_abs(err) < CONFIG.CU_DEADZONE then
		err = 0
	else
		err = err - sign(err) * CONFIG.CU_DEADZONE
	end

	local softErr
	if math_abs(err) <= CONFIG.CU_SOFT_ZONE then
		local n = err / CONFIG.CU_SOFT_ZONE
		softErr = n * n * n * CONFIG.CU_SOFT_ZONE
	else
		softErr = err
	end

	local p = CONFIG.CU_KP * softErr
	vehicle.cuIntegral = vehicle.cuIntegral * CONFIG.CU_INTEGRAL_DECAY
	vehicle.cuIntegral = vehicle.cuIntegral + softErr * dt
	vehicle.cuIntegral = clamp(vehicle.cuIntegral, -CONFIG.CU_INTEGRAL_MAX, CONFIG.CU_INTEGRAL_MAX)
	local i = CONFIG.CU_KI * vehicle.cuIntegral

	local rawDeriv = 0
	if dt > 0 then
		rawDeriv = (vehicle.cuFilteredError - vehicle.cuPrevFilteredError) / dt
	end
	vehicle.cuPrevFilteredError = vehicle.cuFilteredError
	vehicle.cuFilteredDeriv = ema(vehicle.cuFilteredDeriv, rawDeriv, CONFIG.CU_DERIV_FILTER_ALPHA)
	local d = CONFIG.CU_KD * vehicle.cuFilteredDeriv

	local out = clamp(-(p + i + d), -CONFIG.CU_MAX_STEER, CONFIG.CU_MAX_STEER)
	local maxDelta = CONFIG.CU_MAX_STEER_RATE * dt
	local delta = out - vehicle.cuPrevOutputSteer
	if math_abs(delta) > maxDelta then
		out = vehicle.cuPrevOutputSteer + sign(delta) * maxDelta
	end

	vehicle.cuSmoothedSteer = smoothLerp(vehicle.cuSmoothedSteer, out, CONFIG.CU_OUTPUT_FILTER_ALPHA)
	vehicle.cuPrevOutputSteer = vehicle.cuSmoothedSteer

	return vehicle.cuSmoothedSteer, vehicle.cuConfidence
end

--==================================================
-- EDGE LANE LOGIC
--==================================================
local LANE_STEER_FILTER_ALPHA = 0.22
local LANE_SIGN_FLIP_WINDOW = 0.40
local LANE_SIGN_FLIP_DAMP = 0.60
local LANE_OVERSTEER_SUB_MAX = 2.5

local LANE_PRESSURE_GAIN = 2.2
local LANE_PRESSURE_DECAY = 3.0
local LANE_PRESSURE_STEER_MAX = 10.0
local LANE_PRESSURE_RATE = 0.20

local function updateLanePressure(leftClosest, rightClosest, dt)
	local decay = math_max(0, 1 - (LANE_PRESSURE_DECAY * dt))

	vehicle.leftPressure = clamp(
		vehicle.leftPressure * decay + edgePressureFromClosest(leftClosest) * (LANE_PRESSURE_GAIN * dt),
		0, 1
	)

	vehicle.rightPressure = clamp(
		vehicle.rightPressure * decay + edgePressureFromClosest(rightClosest) * (LANE_PRESSURE_GAIN * dt),
		0, 1
	)

	vehicle.pressureSteer = smoothLerp(
		vehicle.pressureSteer,
		(vehicle.leftPressure - vehicle.rightPressure) * LANE_PRESSURE_STEER_MAX,
		LANE_PRESSURE_RATE
	)

	return clamp(vehicle.pressureSteer, -LANE_PRESSURE_STEER_MAX, LANE_PRESSURE_STEER_MAX)
end

local function computeEdgeLaneSteer(leftScan, rightScan, curveFactor)
	curveFactor = clamp(curveFactor or 0, 0, 1)

	local maxRays = CONFIG.LANE_DETECTION_RAYS
	vehicle.smoothedLeftCount = ema(vehicle.smoothedLeftCount, leftScan.count or 0, CONFIG.COUNT_SMOOTH_ALPHA)
	vehicle.smoothedRightCount = ema(vehicle.smoothedRightCount, rightScan.count or 0, CONFIG.COUNT_SMOOTH_ALPHA)

	local normLeft = safeDivide(vehicle.smoothedLeftCount, math_max(1, maxRays), 0)
	local normRight = safeDivide(vehicle.smoothedRightCount, math_max(1, maxRays), 0)

	local delta = normLeft - normRight
	if math_abs(delta) < CONFIG.COUNT_DEADZONE + ((1 - curveFactor) * 0.02) then
		delta = 0
	end

	local steerCount = delta * CONFIG.COUNT_FORCE_FACTOR * CONFIG.MAX_STEER_ANGLE

	local leftDist = (leftScan.forwardAvg and leftScan.forwardAvg < math_huge) and leftScan.forwardAvg or nil
	local rightDist = (rightScan.forwardAvg and rightScan.forwardAvg < math_huge) and rightScan.forwardAvg or nil

	local ideal = CONFIG.IDEAL_LANE_DISTANCE
	if leftDist and rightDist then
		ideal = clamp((leftDist + rightDist) * 0.5, CONFIG.IDEAL_MIN, CONFIG.IDEAL_MAX)
	end

	local steerDistance = 0
	if leftDist or rightDist then
		local leftErr = leftDist and (ideal - leftDist) or 0
		local rightErr = rightDist and (ideal - rightDist) or 0
		local denom = normLeft + normRight
		if denom > 0 then
			steerDistance = ((leftErr * normLeft) - (rightErr * normRight)) / denom * CONFIG.DISTANCE_GAIN
		end
	end

	local raw = clamp(steerCount * 0.6 + steerDistance * 0.9, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
	local totalNorm = clamp(normLeft + normRight, 0, 1)
	local sub = clamp(totalNorm * LANE_OVERSTEER_SUB_MAX, 0, LANE_OVERSTEER_SUB_MAX)
	if raw ~= 0 then
		raw = raw - sign(raw) * sub
	end

	local alpha = clamp(LANE_STEER_FILTER_ALPHA + (curveFactor * 0.10), 0.14, 0.36)
	local filtered = smoothLerp(vehicle.prevLaneSteer, raw, alpha)

	local s = sign(filtered)
	if s ~= 0 and vehicle.lastLaneSign ~= 0 and s ~= vehicle.lastLaneSign then
		local t = now()
		if (t - vehicle.lastLaneFlipT) <= LANE_SIGN_FLIP_WINDOW then
			filtered = filtered * LANE_SIGN_FLIP_DAMP
		end
		vehicle.lastLaneFlipT = t
		vehicle.lastLaneSign = s
	elseif s ~= 0 then
		vehicle.lastLaneSign = s
	end

	local deadzoneStraight = 1.4
	local deadzoneCurve = 0.45
	local deadzone = deadzoneStraight + ((deadzoneCurve - deadzoneStraight) * curveFactor)
	if math_abs(filtered) < deadzone then
		filtered = 0
	end

	vehicle.prevLaneSteer = filtered
	return clamp(filtered, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE), normLeft, normRight
end

local function computeCombinedLaneSteer(cuSteer, cuConfidence, edgeSteer, normLeft, normRight)
	local edgeConfidence = clamp((normLeft + normRight) * 0.5, 0, 1)

	if not vehicle.cuActive then
		return edgeSteer, edgeConfidence
	end

	if cuConfidence >= CONFIG.CU_CONFIDENCE_THRESHOLD then
		local cw = CONFIG.CU_WEIGHT_BASE * cuConfidence
		local ew = CONFIG.CU_EDGE_BACKUP_WEIGHT * edgeConfidence

		if math_abs(cuSteer) > 2 and math_abs(edgeSteer) > 2 and sign(cuSteer) ~= sign(edgeSteer) then
			ew = ew * 0.30
		end

		local tw = cw + ew
		if tw <= 0 then
			return 0, 0
		end

		return clamp((cuSteer * cw + edgeSteer * ew) / tw, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE),
			clamp(cuConfidence * 0.7 + edgeConfidence * 0.3, 0, 1)
	else
		local ew = CONFIG.CU_EDGE_FULL_WEIGHT * edgeConfidence
		local cw = CONFIG.CU_WEIGHT_BASE * cuConfidence * 0.3
		local tw = cw + ew
		if tw <= 0 then
			return 0, 0
		end
		return clamp((cuSteer * cw + edgeSteer * ew) / tw, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE),
			edgeConfidence
	end
end

