--==================================================
-- UTILITIES
--==================================================
local function clamp(v, a, b)
	return math_max(a, math_min(b, v))
end

local function sign(x)
	if x > 0 then
		return 1
	elseif x < 0 then
		return -1
	end
	return 0
end

local function now()
	return time()
end

local function smoothLerp(cur, tgt, a)
	return cur + (tgt - cur) * clamp(a, 0, 1)
end

local function ema(cur, nxt, alpha)
	return cur + (nxt - cur) * clamp(alpha, 0, 1)
end

local function safeDivide(n, d, defaultValue)
	if d == 0 or d ~= d then
		return defaultValue or 0
	end
	return n / d
end

local function wrapDeg(a)
	a = (a + 180) % 360
	if a < 0 then
		a = a + 360
	end
	return a - 180
end

local function getYawDeg(cf)
	local look = cf.LookVector
	return math_deg(math_atan2(look.X, look.Z))
end

local function horizontalSpeed(v)
	return math_sqrt(v.X * v.X + v.Z * v.Z)
end

local function flatDot(a, b)
	return a.X * b.X + a.Z * b.Z
end

local function startsWith(s, prefix)
	return string.sub(s, 1, #prefix) == prefix
end

local function medianArray(values)
	local n = #values
	if n == 0 then
		return nil
	end
	table.sort(values)
	if n % 2 == 1 then
		return values[math.ceil(n / 2)]
	end
	return (values[n / 2] + values[n / 2 + 1]) * 0.5
end

local function edgePressureFromClosest(d)
	if not d or d >= math_huge then
		return 0
	end
	local edgeNear = 0.9
	local edgeFar = 3.2
	return 1 - clamp((d - edgeNear) / (edgeFar - edgeNear), 0, 1)
end

--==================================================
-- RING BUFFER
--==================================================
local RingBuffer = {}
RingBuffer.__index = RingBuffer

function RingBuffer.new(capacity)
	local self = setmetatable({}, RingBuffer)
	self.capacity = capacity
	self.buffer = {}
	self.writeIdx = 0
	self.count = 0
	return self
end

function RingBuffer:push(v)
	self.writeIdx = (self.writeIdx % self.capacity) + 1
	self.buffer[self.writeIdx] = v
	if self.count < self.capacity then
		self.count = self.count + 1
	end
end

function RingBuffer:getMedian()
	if self.count == 0 then
		return nil
	end

	local values = {}
	for i = 1, self.capacity do
		local v = self.buffer[i]
		if v ~= nil then
			table.insert(values, v)
		end
	end

	return medianArray(values)
end

function RingBuffer:getCount()
	return self.count
end

function RingBuffer:clear()
	self.buffer = {}
	self.writeIdx = 0
	self.count = 0
end

function RingBuffer:decayOne()
	if self.count <= 0 then
		return
	end
	local oldest = (self.writeIdx % self.capacity) + 1
	if self.buffer[oldest] ~= nil then
		self.buffer[oldest] = nil
		self.count = math_max(0, self.count - 1)
	end
end

--==================================================
-- SEMANTIC CLASSIFIER
--==================================================
local classCache = setmetatable({}, { __mode = "k" })

local function classifyInstance(inst)
	if not inst then
		return Class.Unknown
	end

	local cached = classCache[inst]
	if cached ~= nil then
		return cached
	end

	local cur = inst
	local hops = 0

	while cur and hops <= SEMANTICS.MaxAncestorHops do
		local n = cur.Name

		if startsWith(n, "Avoid") then
			classCache[inst] = Class.Avoid
			return Class.Avoid
		end
		if startsWith(n, "Vehicles_") then
			classCache[inst] = Class.Vehicle
			return Class.Vehicle
		end
		if startsWith(n, "Pedestrian_") then
			classCache[inst] = Class.Pedestrian
			return Class.Pedestrian
		end
		if startsWith(n, "Road_Barrier") then
			classCache[inst] = Class.Barrier
			return Class.Barrier
		end
		if startsWith(n, "Road_Lanes") then
			classCache[inst] = Class.Lane
			return Class.Lane
		end
		if startsWith(n, "Unknown_Lane") then
			classCache[inst] = Class.MiscLane
			return Class.MiscLane
		end
		if startsWith(n, "Road_") then
			classCache[inst] = Class.Road
			return Class.Road
		end

		cur = cur.Parent
		hops = hops + 1
	end

	classCache[inst] = Class.Unknown
	return Class.Unknown
end

local function isIgnorableForLidar(c)
	return c == Class.Road or c == Class.Lane or c == Class.MiscLane
end

local function isLaneMarkerClass(c)
	return c == Class.Lane or c == Class.MiscLane
end

local function isDynamicActor(c)
	return c == Class.Vehicle or c == Class.Pedestrian
end

local function isObstacleForSteering(c)
	return c == Class.Avoid or c == Class.Vehicle or c == Class.Pedestrian or c == Class.Unknown or c == Class.Barrier
end

