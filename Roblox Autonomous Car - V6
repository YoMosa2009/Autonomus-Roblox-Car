local function updateVisual(v, s, e, c)
	if not v then
		return
	end

	local d = e - s
	local l = d.Magnitude
	if l < 0.01 then
		return
	end

	v.Size = Vector3.new(v.Size.X, v.Size.Y, l)
	v.CFrame = CFrame.new(s:Lerp(e, 0.5), e)
	if c then
		v.Color = c
	end
end

--==================================================
-- RAYCAST SKIP
--==================================================
local function raycastSkipClasses(origin, dir, params, maxSkips)
	local remaining = dir.Magnitude
	if remaining <= 0 then
		return nil, nil
	end

	local unit = dir.Unit
	local o = origin

	for _ = 1, maxSkips do
		local r = Workspace:Raycast(o, unit * remaining, params)
		if not r or not r.Instance then
			return nil, nil
		end

		local c = classifyInstance(r.Instance)
		if not isIgnorableForLidar(c) then
			return r, c
		end

		local hitDist = (r.Position - o).Magnitude
		remaining = remaining - hitDist
		if remaining <= 0.1 then
			return nil, nil
		end

		o = r.Position + unit * 0.05
	end

	return nil, nil
end

