local Lidar = {}
Lidar.__index = Lidar

function Lidar.new(part)
	local self = setmetatable({}, Lidar)
	self.part = part
	self.beams = {}
	self.threats = {}

	self.leadDist = math_huge
	self.prevLeadDist = math_huge
	self.leadValid = false
	self.leadClosingVel = 0

	self.pedDist = math_huge
	self.pedValid = false
	self.pedHitCount = 0
	self.pedAngleMean = 0
	self.pedClosestAngle = 0
	self.pedLastSeenT = -math_huge

	for i = 1, CONFIG.LIDAR_BEAM_COUNT do
		local t = (i - 1) / math_max(CONFIG.LIDAR_BEAM_COUNT - 1, 1)
		local angle = -CONFIG.LIDAR_SPREAD_HALF_ANGLE + t * (CONFIG.LIDAR_SPREAD_HALF_ANGLE * 2)

		self.beams[i] = {
			angle = angle,
			localVec = CFrame.Angles(0, math_rad(angle), 0) * Vector3.new(0, 0, -CONFIG.LIDAR_RANGE),
			valid = false,
			dist = math_huge,
			classId = Class.Unknown,
			hitPos = nil,
			emaDist = math_huge,
			emaHit = false,
			hitFrames = 0,
			visual = createVisual(CONFIG.LIDAR_RANGE, 0.12),
		}
	end

	return self
end

local function threatLevelFrom(dist, ttc, lat, fwd)
	if fwd < CONFIG.PATH_FORWARD_MIN then
		return ThreatLevel.NONE, 0
	end

	local absLat = math_abs(lat)
	local inCenter = absLat <= CONFIG.PATH_WIDTH_CENTER
	local inPath = absLat <= CONFIG.PATH_WIDTH_FULL

	local level = ThreatLevel.NONE
	local score = 0

	if inCenter then
		if dist <= CONFIG.THREAT_ZONE_CRITICAL or ttc <= CONFIG.TTC_CRITICAL then
			level = ThreatLevel.CRITICAL
			score = 1
		elseif dist <= CONFIG.THREAT_ZONE_WARNING or ttc <= CONFIG.TTC_WARNING then
			level = ThreatLevel.WARNING
			score = 0.75
		elseif dist <= CONFIG.THREAT_ZONE_CAUTION or ttc <= CONFIG.TTC_CAUTION then
			level = ThreatLevel.CAUTION
			score = 0.5
		elseif dist <= CONFIG.THREAT_ZONE_MONITOR then
			level = ThreatLevel.MONITOR
			score = 0.25
		end
	elseif inPath then
		if dist <= CONFIG.THREAT_ZONE_CRITICAL then
			level = ThreatLevel.WARNING
			score = 0.7
		elseif dist <= CONFIG.THREAT_ZONE_WARNING then
			level = ThreatLevel.CAUTION
			score = 0.45
		elseif dist <= CONFIG.THREAT_ZONE_CAUTION then
			level = ThreatLevel.MONITOR
			score = 0.25
		end

		score = score * (1 - (absLat - CONFIG.PATH_WIDTH_CENTER) / (CONFIG.PATH_WIDTH_FULL - CONFIG.PATH_WIDTH_CENTER) * 0.5)
	end

	return level, score
end

function Lidar:getEmptyScan()
	return {
		maxThreatLevel = ThreatLevel.NONE,
		maxThreatScore = 0,
		threatDistance = math_huge,
		threatLateral = 0,
		threatForward = 0,
		threatCount = 0,

		leadValid = false,
		leadDist = math_huge,
		leadClosingVel = 0,

		pedValid = false,
		pedDist = math_huge,
		pedHitCount = 0,
		pedAngleMean = 0,
		pedClosestAngle = 0,
		pedLastSeenAge = 999,
	}
end

function Lidar:scan(dt)
	if not self.part or not self.part.Parent then
		return self:getEmptyScan()
	end

	local pos = self.part.Position
	local ori = self.part.CFrame

	local forwardVel = 0
	if primary and primary.Parent then
		local vel = primary.AssemblyLinearVelocity
		local lv = ori.LookVector
		forwardVel = math_max(0, flatDot(vel, lv))
	end

	local prevLeadDist = self.leadDist
	self.prevLeadDist = prevLeadDist
	self.threats = {}

	local pedCount = 0
	local pedAngleSum = 0
	local pedClosestAngle = 0
	local pedBestDist = math_huge
	local pedFound = false

	local bestLeadDist = math_huge
	local bestLeadFound = false

	for i = 1, #self.beams do
		local b = self.beams[i]
		local worldDir = ori:VectorToWorldSpace(b.localVec)
		local hit, classId = raycastSkipClasses(pos, worldDir, obstacleRayParams, CONFIG.LIDAR_SKIP_LIMIT)

		if hit and hit.Instance and classId then
			local rawDist = (hit.Position - pos).Magnitude
			b.classId = classId
			b.hitPos = hit.Position
			b.hitFrames = (b.hitFrames or 0) + 1

			if (not b.emaHit) or b.emaDist >= CONFIG.LIDAR_RANGE * 0.90 then
				b.emaDist = rawDist
				b.emaHit = true
			else
				b.emaDist = b.emaDist + (rawDist - b.emaDist) * CONFIG.LIDAR_BEAM_EMA_ALPHA
			end

			b.dist = rawDist
			b.valid = true

			local localPos = ori:PointToObjectSpace(hit.Position)

			if isObstacleForSteering(classId) then
				local lat = localPos.X
				local fwd = -localPos.Z
				local ttc = math_huge
				if forwardVel > 0.1 then
					ttc = rawDist / forwardVel
				end

				local level, score = threatLevelFrom(rawDist, ttc, lat, fwd)
				if level > ThreatLevel.NONE then
					table.insert(self.threats, {
						isValid = true,
						level = level,
						score = score,
						distance = rawDist,
						lateral = lat,
						forward = fwd,
						ttc = ttc,
						classId = classId,
						pos = hit.Position,
						angle = b.angle,
					})
				end
			end

			if classId == Class.Pedestrian then
				local fwd = -localPos.Z
				if fwd > CONFIG.PATH_FORWARD_MIN and math_abs(localPos.X) <= CONFIG.PATH_WIDTH_FULL then
					pedCount = pedCount + 1
					pedAngleSum = pedAngleSum + b.angle
					if rawDist < pedBestDist then
						pedBestDist = rawDist
						pedClosestAngle = b.angle
						pedFound = true
					end
				end
			end

			if isDynamicActor(classId) and classId ~= Class.Pedestrian then
				local fwd = -localPos.Z
				if fwd > CONFIG.PATH_FORWARD_MIN and math_abs(localPos.X) <= CONFIG.PATH_WIDTH_FULL then
					if rawDist < bestLeadDist then
						bestLeadDist = rawDist
						bestLeadFound = true
					end
				end
			end

			if b.visual then
				local color
				if rawDist <= CONFIG.THREAT_ZONE_CRITICAL then
					color = Color3.new(1, 0, 0)
				elseif rawDist <= CONFIG.THREAT_ZONE_WARNING then
					color = Color3.new(1, 0.5, 0)
				elseif rawDist <= CONFIG.THREAT_ZONE_CAUTION then
					color = Color3.new(1, 1, 0)
				else
					color = Color3.new(0, 1, 0)
				end
				updateVisual(b.visual, pos, pos + worldDir, color)
			end
		else
			b.dist = math_huge
			b.classId = Class.Unknown
			b.hitPos = nil
			b.hitFrames = 0
			b.emaHit = false

			if b.emaDist < CONFIG.LIDAR_RANGE then
				b.emaDist = b.emaDist + (CONFIG.LIDAR_RANGE - b.emaDist) * CONFIG.LIDAR_BEAM_EMA_CLEAR_ALPHA
				if b.emaDist > CONFIG.LIDAR_RANGE * 0.92 then
					b.emaDist = math_huge
				end
			end

			b.valid = false

			if b.visual then
				updateVisual(b.visual, pos, pos + worldDir, Color3.new(0, 0.5, 1))
			end
		end
	end

	if bestLeadFound then
		self.leadDist = bestLeadDist
		self.leadValid = true
	else
		self.leadDist = math_huge
		self.leadValid = false
	end

	local closingVel = 0
	if dt > 0 and self.leadValid and prevLeadDist < math_huge and self.leadDist < math_huge then
		closingVel = (prevLeadDist - self.leadDist) / dt
		if closingVel < 0 then
			closingVel = 0
		end
	end
	self.leadClosingVel = closingVel

	local maxThreatLevel = ThreatLevel.NONE
	local maxThreatScore = 0
	local threatDistance = math_huge
	local threatLateral = 0
	local threatForward = 0

	for _, th in ipairs(self.threats) do
		if th.isValid and th.score > maxThreatScore then
			maxThreatScore = th.score
			maxThreatLevel = th.level
			threatDistance = th.distance
			threatLateral = th.lateral
			threatForward = th.forward
		end
	end

	self.pedHitCount = pedCount
	self.pedValid = pedFound
	self.pedDist = pedFound and pedBestDist or math_huge
	if pedCount > 0 then
		self.pedAngleMean = pedAngleSum / pedCount
		self.pedClosestAngle = pedClosestAngle
	end
	if pedFound then
		self.pedLastSeenT = now()
	end

	return {
		maxThreatLevel = maxThreatLevel,
		maxThreatScore = maxThreatScore,
		threatDistance = threatDistance,
		threatLateral = threatLateral,
		threatForward = threatForward,
		threatCount = #self.threats,

		leadValid = self.leadValid,
		leadDist = self.leadDist,
		leadClosingVel = self.leadClosingVel,

		pedValid = self.pedValid,
		pedDist = self.pedDist,
		pedHitCount = self.pedHitCount,
		pedAngleMean = self.pedAngleMean,
		pedClosestAngle = self.pedClosestAngle,
		pedLastSeenAge = pedFound and 0 or (now() - self.pedLastSeenT),
	}
end

function Lidar:destroy()
	for _, b in ipairs(self.beams) do
		if b.visual then
			b.visual:Destroy()
		end
	end
end

--==================================================
-- CLUSTERING / TRACKING
--==================================================
local function clusterLidarBeams(lidarObj)
	local clusters = {}
	local cur = nil
	local beams = lidarObj and lidarObj.beams or {}
	local n = #beams

	for i = 1, n do
		local b = beams[i]
		local d = b.emaHit and b.emaDist or math_huge
		local active = b.valid and d < CONFIG.LIDAR_RANGE * 0.92

		if active then
			if not cur then
				cur = {
					startIdx = i,
					endIdx = i,
					minDist = d,
					sumAngle = b.angle,
					beamCount = 1,
				}
			else
				local prev = beams[i - 1]
				local prevD = (prev and prev.emaHit and prev.emaDist) or math_huge
				local distJump = math_abs(d - prevD)

				if distJump > CONFIG.CLUSTER_DIST_SPLIT or (not prev) or (not prev.valid) then
					cur.midAngle = cur.sumAngle / cur.beamCount
					if cur.beamCount >= CONFIG.CLUSTER_MIN_BEAMS then
						table.insert(clusters, cur)
					end
					cur = {
						startIdx = i,
						endIdx = i,
						minDist = d,
						sumAngle = b.angle,
						beamCount = 1,
					}
				else
					cur.endIdx = i
					cur.minDist = math_min(cur.minDist, d)
					cur.sumAngle = cur.sumAngle + b.angle
					cur.beamCount = cur.beamCount + 1
				end
			end
		else
			if cur then
				cur.midAngle = cur.sumAngle / cur.beamCount
				if cur.beamCount >= CONFIG.CLUSTER_MIN_BEAMS then
					table.insert(clusters, cur)
				end
				cur = nil
			end
		end
	end

	if cur then
		cur.midAngle = cur.sumAngle / cur.beamCount
		if cur.beamCount >= CONFIG.CLUSTER_MIN_BEAMS then
			table.insert(clusters, cur)
		end
	end

	return clusters
end

local function extractTrackDetections(lidarObj, sensorPart)
	local detections = {}
	if not sensorPart or not sensorPart.Parent then
		return detections
	end

	local ori = sensorPart.CFrame
	local clusters = clusterLidarBeams(lidarObj)

	for _, cl in ipairs(clusters) do
		local mid = math.floor((cl.startIdx + cl.endIdx) * 0.5 + 0.5)
		local beam = lidarObj.beams[mid]
		if beam and beam.valid and beam.hitPos then
			local classId = beam.classId
			if isDynamicActor(classId) or isObstacleForSteering(classId) then
				local lp = ori:PointToObjectSpace(beam.hitPos)
				table.insert(detections, {
					classId = classId,
					pos = beam.hitPos,
					dist = (beam.hitPos - sensorPart.Position).Magnitude,
					lateral = lp.X,
					forward = -lp.Z,
				})
			end
		end
	end

	return detections
end

local function updateTracks(detections, dt)
	local t = now()

	for id, tr in pairs(tracks) do
		tr.age = t - tr.lastSeen
		if tr.age > CONFIG.TRACK_MAX_AGE then
			tracks[id] = nil
		end
	end

	for _, det in ipairs(detections) do
		local bestId = nil
		local bestDist = math_huge

		for id, tr in pairs(tracks) do
			if tr.classId == det.classId then
				local d = (tr.pos - det.pos).Magnitude
				if d < CONFIG.TRACK_MATCH_DIST and d < bestDist then
					bestDist = d
					bestId = id
				end
			end
		end

		if bestId then
			local tr = tracks[bestId]
			local prevPos = tr.pos
			tr.pos = tr.pos:Lerp(det.pos, CONFIG.TRACK_SMOOTH_ALPHA)
			if dt > 0 then
				local rawVel = (tr.pos - prevPos) / dt
				tr.vel = tr.vel:Lerp(rawVel, 0.35)
			end
			tr.lastSeen = t
			tr.age = 0
			tr.hits = tr.hits + 1
			tr.confirmed = tr.hits >= CONFIG.TRACK_CONFIRM_FRAMES
			tr.dist = det.dist
			tr.lateral = det.lateral
			tr.forward = det.forward
		else
			local id = nextTrackId
			nextTrackId = nextTrackId + 1
			tracks[id] = {
				id = id,
				classId = det.classId,
				pos = det.pos,
				vel = Vector3.zero,
				lastSeen = t,
				age = 0,
				hits = 1,
				confirmed = false,
				dist = det.dist,
				lateral = det.lateral,
				forward = det.forward,
			}
		end
	end
end

local function getConfirmedTracks()
	local out = {}
	for _, tr in pairs(tracks) do
		if tr.confirmed and tr.age <= CONFIG.TRACK_MAX_AGE then
			table.insert(out, tr)
		end
	end
	return out
end

--==================================================
-- ROAD SPACE / OCCUPANCY / BLIND SPOT
--==================================================
local function roadSpaces()
	local leftAvail = vehicle.roadBoundsValid and vehicle.roadLeftDist < math_huge
	local rightAvail = vehicle.roadBoundsValid and vehicle.roadRightDist < math_huge

	local leftDist = leftAvail and vehicle.roadLeftDist or nil
	local rightDist = rightAvail and vehicle.roadRightDist or nil

	if leftDist and not rightDist then
		rightDist = leftDist
	end
	if rightDist and not leftDist then
		leftDist = rightDist
	end

	local fallbackRoadHalf = 8.0
	local edgeMargin = 1.0

	local leftSpace = leftDist and (leftDist - CONFIG.CAR_HALF_WIDTH - edgeMargin) or fallbackRoadHalf
	local rightSpace = rightDist and (rightDist - CONFIG.CAR_HALF_WIDTH - edgeMargin) or fallbackRoadHalf

	return math_max(leftSpace, 0.5), math_max(rightSpace, 0.5)
end

local function buildForwardOccupancy(lidarObj)
	local lookahead = CONFIG.OCCUPANCY_LOOKAHEAD
	local lateralHalf = CONFIG.OCCUPANCY_LATERAL_HALF
	local cellF = CONFIG.OCCUPANCY_CELL_FORWARD
	local cellL = CONFIG.OCCUPANCY_CELL_LATERAL

	local rows = math_max(1, math.floor(lookahead / cellF + 0.5))
	local cols = math_max(1, math.floor((lateralHalf * 2) / cellL + 0.5))

	local grid = {}
	for r = 1, rows do
		grid[r] = {}
		for c = 1, cols do
			grid[r][c] = 0
		end
	end

	if not sensorC or not sensorC.Parent then
		return grid, rows, cols
	end

	local ori = sensorC.CFrame

	for _, b in ipairs(lidarObj.beams) do
		if b.valid and b.hitPos and isObstacleForSteering(b.classId) then
			local lp = ori:PointToObjectSpace(b.hitPos)
			local fwd = -lp.Z
			local lat = lp.X

			if fwd >= 0 and fwd <= lookahead and math_abs(lat) <= lateralHalf then
				local row = clamp(math.floor(fwd / cellF) + 1, 1, rows)
				local col = clamp(math.floor((lat + lateralHalf) / cellL) + 1, 1, cols)
				grid[row][col] = grid[row][col] + 1
			end
		end
	end

	return grid, rows, cols
end

local function updateRayDensity(lidarObj)
	local blocked = 0
	local caution = 0
	local total = 0

	for _, b in ipairs(lidarObj.beams) do
		local a = b.angle or 0
		if math_abs(a) <= CONFIG.DENSITY_FORWARD_ANGLE then
			total = total + 1
			local d = b.valid and b.dist or CONFIG.LIDAR_RANGE
			if d < CONFIG.DENSITY_BLOCK_DIST then
				blocked = blocked + 1
			elseif d < CONFIG.DENSITY_CAUTION_DIST then
				caution = caution + 1
			end
		end
	end

	local blockedNorm = (total > 0) and (blocked / total) or 0
	local cautionNorm = (total > 0) and (caution / total) or 0

	vehicle.densityBlocked = ema(vehicle.densityBlocked, blockedNorm, CONFIG.DENSITY_SMOOTH_ALPHA)
	vehicle.densityCaution = ema(vehicle.densityCaution, cautionNorm, CONFIG.DENSITY_SMOOTH_ALPHA)

	local mult = 1.0
	if vehicle.densityBlocked > 0.02 then
		local t = clamp(vehicle.densityBlocked / 0.85, 0, 1)
		mult = 1.0 + (0.45 - 1.0) * t
	elseif vehicle.densityCaution > 0.02 then
		local t = clamp(vehicle.densityCaution / 0.85, 0, 1)
		mult = 1.0 + (0.72 - 1.0) * t
	end

	vehicle.densitySpeedMult = clamp(mult, 0.45, 1.0)
end

local function updateBlindSpots()
	if not sensorC or not sensorC.Parent then
		vehicle.blindSpotLeftClear = true
		vehicle.blindSpotRightClear = true
		return
	end

	local pos = sensorC.Position
	local ori = sensorC.CFrame

	local leftClear = true
	local rightClear = true

	for _, ang in ipairs(CONFIG.BLIND_SPOT_ANGLES) do
		local dir = ori:VectorToWorldSpace(CFrame.Angles(0, math_rad(ang), 0) * Vector3.new(0, 0, -CONFIG.BLIND_SPOT_RANGE))
		local hit, classId = raycastSkipClasses(pos, dir, obstacleRayParams, 4)
		if hit and classId and isObstacleForSteering(classId) then
			if ang < 0 then
				leftClear = false
			else
				rightClear = false
			end
		end
	end

	vehicle.blindSpotLeftClear = leftClear
	vehicle.blindSpotRightClear = rightClear
end

local function checkAEB(lidarScan)
	if not lidarScan.leadValid then
		vehicle.aebActive = false
		return false
	end

	local leadDist = lidarScan.leadDist or math_huge
	local closingVel = lidarScan.leadClosingVel or 0

	if closingVel < 3.0 or leadDist >= 12.0 then
		vehicle.aebActive = false
		return false
	end

	local ttc = leadDist / math_max(closingVel, 0.01)
	vehicle.aebActive = (ttc <= 1.0)
	return vehicle.aebActive
end

--==================================================
-- ROUTE / MAP HOOKS (PART 3)
--==================================================
local waypointFolder = nil
local slowZoneFolder = nil
local stopZoneFolder = nil

if CONFIG.USE_WAYPOINTS then
	waypointFolder = Workspace:FindFirstChild(CONFIG.WAYPOINT_FOLDER_NAME)
end
if CONFIG.USE_SLOW_ZONES then
	slowZoneFolder = Workspace:FindFirstChild(CONFIG.SLOW_ZONE_FOLDER_NAME)
end
if CONFIG.USE_STOP_ZONES then
	stopZoneFolder = Workspace:FindFirstChild(CONFIG.STOP_ZONE_FOLDER_NAME)
end

local waypointList = {}
local currentWaypointIndex = 1

local function refreshWaypoints()
	waypointList = {}
	if not waypointFolder then
		return
	end

	local temp = {}
	for _, child in ipairs(waypointFolder:GetChildren()) do
		if child:IsA("BasePart") then
			table.insert(temp, child)
		end
	end

	table.sort(temp, function(a, b)
		return a.Name < b.Name
	end)

	waypointList = temp
	if currentWaypointIndex > #waypointList then
		currentWaypointIndex = 1
	end
end

refreshWaypoints()

local function computeWaypointSteer()
	if not CONFIG.USE_WAYPOINTS then
		return 0, false
	end
	if not primary or not primary.Parent then
		return 0, false
	end
	if #waypointList == 0 then
		return 0, false
	end

	local wp = waypointList[currentWaypointIndex]
	if not wp or not wp.Parent then
		refreshWaypoints()
		return 0, false
	end

	local pos = primary.Position
	local toWP = wp.Position - pos
	local dist = toWP.Magnitude

	if dist <= CONFIG.WAYPOINT_REACHED_DIST then
		currentWaypointIndex = currentWaypointIndex + 1
		if currentWaypointIndex > #waypointList then
			currentWaypointIndex = 1
		end
		wp = waypointList[currentWaypointIndex]
		if not wp then
			return 0, false
		end
		toWP = wp.Position - pos
	end

	local localTarget = primary.CFrame:PointToObjectSpace(wp.Position)
	local ang = math.deg(math.atan2(localTarget.X, -localTarget.Z))
	local steer = clamp(ang * CONFIG.WAYPOINT_LOOKAHEAD_GAIN, -CONFIG.WAYPOINT_MAX_STEER, CONFIG.WAYPOINT_MAX_STEER)
	return steer, true
end

local function getSlowZoneMult()
	if not CONFIG.USE_SLOW_ZONES or not slowZoneFolder or not primary or not primary.Parent then
		return 1.0
	end

	for _, zone in ipairs(slowZoneFolder:GetChildren()) do
		if zone:IsA("BasePart") then
			local lp = zone.CFrame:PointToObjectSpace(primary.Position)
			local half = zone.Size * 0.5
			if math_abs(lp.X) <= half.X and math_abs(lp.Y) <= half.Y and math_abs(lp.Z) <= half.Z then
				local attr = zone:GetAttribute("SpeedMult")
				if typeof(attr) == "number" then
					return clamp(attr, 0.05, 1.0)
				end
				return CONFIG.SLOW_ZONE_DEFAULT_MULT
			end
		end
	end

	return 1.0
end

local function updateStopZones(t)
	if not CONFIG.USE_STOP_ZONES or not stopZoneFolder or not primary or not primary.Parent then
		return
	end

	for _, zone in ipairs(stopZoneFolder:GetChildren()) do
		if zone:IsA("BasePart") then
			local lp = zone.CFrame:PointToObjectSpace(primary.Position)
			local half = zone.Size * 0.5
			if math_abs(lp.X) <= half.X and math_abs(lp.Y) <= half.Y and math_abs(lp.Z) <= half.Z then
				vehicle.stopZoneUntil = math_max(vehicle.stopZoneUntil, t + CONFIG.STOP_ZONE_HOLD_TIME)
			end
		end
	end
end

--==================================================
-- ACTUATION
--==================================================
local function applySteering(angle, rate)
	rate = rate or CONFIG.STEERING_RATE
	local target = clamp(angle, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE) * (CONFIG.STEER_SIGN or 1)
	vehicle.currentSteer = smoothLerp(vehicle.currentSteer, target, rate)

	for i = 1, #steeringHinges do
		local hinge = steeringHinges[i]
		pcall(function()
			hinge.TargetAngle = vehicle.currentSteer
		end)
	end
end

local function applySpeedRaw(speed)
	for i = 1, #leftMotors do
		local m = leftMotors[i]
		pcall(function()
			m.AngularVelocity = speed
		end)
	end
	for i = 1, #rightMotors do
		local m = rightMotors[i]
		pcall(function()
			m.AngularVelocity = -speed
		end)
	end
end

local function applySpeedSmooth(targetSpeed, dt)
	local current = vehicle.speedCurrent
	local accel = (now() < vehicle.pedSlowUntil) and 12.0 or CONFIG.SPEED_ACCEL

	if targetSpeed > current then
		current = math_min(current + accel * dt, targetSpeed)
	else
		current = math_max(current - CONFIG.SPEED_DECEL * dt, targetSpeed)
	end

	vehicle.speedCurrent = current
	applySpeedRaw(current)
end

--==================================================
-- ADVANCED HELPERS
--==================================================
local function allForwardBlockedMajor(lidarScan)
	if (lidarScan.maxThreatLevel or ThreatLevel.NONE) < ThreatLevel.WARNING and (lidarScan.maxThreatScore or 0) < 0.85 then
		return false
	end

	local clearMin = getDynamicClearMin()
	local blocked = 0
	local total = 0

	for _, b in ipairs(lidar.beams) do
		local a = b.angle or 0
		if math_abs(a) <= CONFIG.LIDAR_SPREAD_HALF_ANGLE * 0.95 then
			total = total + 1
			local d = (b.emaHit and b.emaDist < math_huge) and b.emaDist or (b.valid and b.dist or CONFIG.LIDAR_RANGE)
			if d < clearMin then
				blocked = blocked + 1
			end
		end
	end

	return total > 0 and blocked >= total
end

local function computeYawDampingCorr(targetSteer)
	if not primary or not primary.Parent then
		return 0
	end

	local yawRate = math_abs(math_deg(primary.AssemblyAngularVelocity.Y))
	local desiredYaw = math_abs(targetSteer) * CONFIG.AVOID_YAW_TARGET_PER_STEER
	local err = desiredYaw - yawRate

	local corr = 0
	if err < 0 then
		corr = -sign(targetSteer) * clamp((-err) * CONFIG.AVOID_YAW_DAMP_GAIN, 0, CONFIG.AVOID_YAW_MAX_CORR)
	else
		corr = sign(targetSteer) * clamp(err * CONFIG.AVOID_YAW_ASSIST_GAIN, 0, CONFIG.AVOID_YAW_MAX_CORR * 0.7)
	end
	return corr
end

local function estimateLateralError(cuScan)
	if cuScan and cuScan.valid then
		return cuScan.lateralError
	end

	if vehicle.roadBoundsValid then
		local l = vehicle.roadLeftDist < math_huge and vehicle.roadLeftDist or 8.0
		local r = vehicle.roadRightDist < math_huge and vehicle.roadRightDist or 8.0
		return (l - r) * 0.5
	end

	return 0
end

local function predictTrackPenalty(midAngle, tracksList, curLatErr)
	local penalty = 0
	local look = CONFIG.AVOID_TARGET_LOOKAHEAD
	local dirLat = math.sin(math.rad(midAngle)) * look

	for _, tr in ipairs(tracksList) do
		local predictedPos = tr.pos + tr.vel * CONFIG.PREDICTION_TIME

		if sensorC and sensorC.Parent then
			local lp = sensorC.CFrame:PointToObjectSpace(predictedPos)
			local predLat = lp.X
			local predFwd = -lp.Z

			if predFwd > 0 and predFwd < (look + CONFIG.PREDICTION_FORWARD_INFLATE) then
				local corridorEndLat = curLatErr + dirLat
				local latGap = math_abs(predLat - corridorEndLat)

				local laneWidthInflate = CONFIG.CAR_HALF_WIDTH + CONFIG.PREDICTION_LATERAL_INFLATE
				if latGap < laneWidthInflate then
					local nearF = 1 - clamp(predFwd / (look + CONFIG.PREDICTION_FORWARD_INFLATE), 0, 1)
					local nearL = 1 - clamp(latGap / laneWidthInflate, 0, 1)
					local classMult = (tr.classId == Class.Pedestrian) and 1.25 or 1.0
					penalty = penalty + nearF * nearL * CONFIG.PREDICTED_TRACK_COST * classMult
				end
			end
		end
	end

	return penalty
end

local function occupancyPenaltyForAngle(midAngle, occupancyGrid, rows, cols)
	local look = CONFIG.AVOID_TARGET_LOOKAHEAD
	local targetLat = math.sin(math.rad(midAngle)) * look

	local latHalf = CONFIG.OCCUPANCY_LATERAL_HALF
	local cellLat = CONFIG.OCCUPANCY_CELL_LATERAL
	local cellFwd = CONFIG.OCCUPANCY_CELL_FORWARD

	local total = 0
	local samples = 0

	for step = 1, rows do
		local fwd = step * cellFwd
		local lat = targetLat * clamp(fwd / math.max(look, 0.1), 0, 1)
		local col = clamp(math.floor((lat + latHalf) / cellLat) + 1, 1, cols)

		local cell = occupancyGrid[step][col] or 0
		total = total + cell
		samples = samples + 1

		if col > 1 then
			total = total + (occupancyGrid[step][col - 1] or 0) * 0.5
		end
		if col < cols then
			total = total + (occupancyGrid[step][col + 1] or 0) * 0.5
		end
	end

	if samples <= 0 then
		return 0
	end

	local sideBias = math_abs(midAngle) / math_max(CONFIG.LIDAR_SPREAD_HALF_ANGLE, 1)
	return (total / samples) * CONFIG.OCCUPANCY_COST + sideBias * CONFIG.OCCUPANCY_SIDE_BIAS
end

local function frontOverrideSteer()
	local bestD = math_huge
	local bestAngle = 0

	for _, b in ipairs(lidar.beams) do
		local a = b.angle or 0
		local d = b.valid and b.dist or CONFIG.LIDAR_RANGE
		if math_abs(a) <= CONFIG.AVOID_FRONT_OVERRIDE_ANGLE and d < bestD then
			bestD = d
			bestAngle = a
		end
	end

	if bestD <= CONFIG.AVOID_FRONT_OVERRIDE_DIST then
		local away = -sign(bestAngle)
		if away == 0 then
			away = (vehicle.leftPressure <= vehicle.rightPressure) and -1 or 1
		end
		return away * CONFIG.AVOID_FRONT_OVERRIDE_STEER, true
	end

	return 0, false
end

--==================================================
-- AVOIDANCE
--==================================================
local function computeAvoidanceSteer(lidarScan, laneSteer, pressureSteer, laneConfidence, dt, cuScan)
	local tl = lidarScan.maxThreatLevel or ThreatLevel.NONE

	if (lidarScan.threatCount or 0) == 0 and vehicle.avoidPhase ~= AvoidPhase.ACTIVE then
		vehicle.avoidBlocked = false
		vehicle.avoidSteer = smoothLerp(vehicle.avoidSteer, 0, 0.25)
		return vehicle.avoidSteer, false
	end

	local immediateSteer, hasFrontOverride = frontOverrideSteer()
	if hasFrontOverride then
		vehicle.avoidBlocked = true
		vehicle.avoidSteer = smoothLerp(vehicle.avoidSteer, immediateSteer, 0.50)
		return clamp(vehicle.avoidSteer, -CONFIG.AVOID_MAX_STEER, CONFIG.AVOID_MAX_STEER), allForwardBlockedMajor(lidarScan)
	end

	local leftSpace, rightSpace = roadSpaces()
	local half = CONFIG.LIDAR_SPREAD_HALF_ANGLE
	local desiredSteer = clamp(laneSteer + pressureSteer, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
	local desiredAngle = (desiredSteer / CONFIG.MAX_STEER_ANGLE) * half
	local look = CONFIG.AVOID_TARGET_LOOKAHEAD
	local clearMin = getDynamicClearMin()

	local curLatErr = 0
	local haveLatErr = false

	if cuScan and cuScan.valid then
		curLatErr = cuScan.lateralError or 0
		haveLatErr = true
	elseif vehicle.roadBoundsValid then
		local l = vehicle.roadLeftDist < math_huge and vehicle.roadLeftDist or nil
		local r = vehicle.roadRightDist < math_huge and vehicle.roadRightDist or nil
		if l and r then
			curLatErr = (l - r) * 0.5
			haveLatErr = true
		end
	end

	local clusters = clusterLidarBeams(lidar)
	local occupancyGrid, occRows, occCols = buildForwardOccupancy(lidar)
	local confirmedTracks = getConfirmedTracks()

	local beam = {}
	local n = #lidar.beams

	for i = 1, n do
		local b = lidar.beams[i]
		local min5 = CONFIG.LIDAR_RANGE

		for j = i - 2, i + 2 do
			local k = clamp(j, 1, n)
			local bk = lidar.beams[k]
			local d = (bk.emaHit and bk.emaDist < math_huge) and bk.emaDist or (bk.valid and bk.dist or CONFIG.LIDAR_RANGE)
			if d < min5 then
				min5 = d
			end
		end

		local a = b.angle or 0
		local clear = math_min(min5, CONFIG.LIDAR_RANGE)
		local latShift = math.sin(math.rad(a)) * look

		local roadFeasible = true
		if latShift < 0 and (-latShift) > leftSpace then
			roadFeasible = false
		end
		if latShift > 0 and latShift > rightSpace then
			roadFeasible = false
		end

		beam[i] = {
			angle = a,
			clear = clear,
			open = (clear >= clearMin and roadFeasible),
			roadFeasible = roadFeasible,
		}
	end

	local corridors = {}
	local startIdx = nil

	for i = 1, n do
		if beam[i].open then
			if not startIdx then
				startIdx = i
			end
		else
			if startIdx then
				table.insert(corridors, {s = startIdx, e = i - 1})
				startIdx = nil
			end
		end
	end
	if startIdx then
		table.insert(corridors, {s = startIdx, e = n})
	end

	local roadHalfForPenalty = CONFIG.AVOID_LATERAL_NORM_HALF
	if haveLatErr then
		local measuredHalf = math_max((leftSpace + rightSpace) * 0.5, 1.5)
		roadHalfForPenalty = math_min(measuredHalf, CONFIG.AVOID_LATERAL_NORM_HALF * 1.6)
	end

	local nowT = now()
	local angleSticky = nowT < vehicle.avoidChosenUntil
	local stickyAngle = vehicle.avoidChosenAngle
	local stickyWidth = math_max(CONFIG.AVOID_ANGLE_STICKY_WIDTH_DEG, 1)

	local function corridorScore(c)
		local width = c.e - c.s + 1
		if width < CONFIG.AVOID_MIN_GAP_BEAMS then
			return -math_huge, 0
		end

		local mid = math.floor((c.s + c.e) * 0.5 + 0.5)
		local midAngle = beam[mid].angle

		local minClear = math_huge
		local avgClear = 0
		for i = c.s, c.e do
			local cl = beam[i].clear
			if cl < minClear then
				minClear = cl
			end
			avgClear = avgClear + cl
		end
		avgClear = avgClear / width

		local score = 0
		score = score + clamp(width / n, 0, 1) * 1.8
		score = score + clamp(minClear / CONFIG.LIDAR_RANGE, 0, 1) * 1.5
		score = score + clamp(avgClear / CONFIG.LIDAR_RANGE, 0, 1) * 1.0
		score = score + clamp(1 - math_abs(midAngle - desiredAngle) / (half + 1e-6), 0, 1) * 0.8
		score = score + clamp(1 - math_abs(midAngle) / (half + 1e-6), 0, 1) * 2.25

		if midAngle < 0 then
			score = score - vehicle.leftPressure * 1.0
		else
			score = score - vehicle.rightPressure * 1.0
		end

		for _, cl in ipairs(clusters) do
			local clMid = math.floor((cl.startIdx + cl.endIdx) * 0.5 + 0.5)
			if clMid >= c.s - 3 and clMid <= c.e + 3 then
				local densityPenalty = clamp(cl.beamCount / 6, 0, 1) * CONFIG.CLUSTER_DENSITY_PENALTY
				score = score - densityPenalty
			end
		end

		if midAngle < 0 then
			if vehicle.blindSpotLeftClear then
				score = score + CONFIG.BLIND_SPOT_BIAS
			else
				score = score - CONFIG.BLIND_SPOT_BIAS
			end
		else
			if vehicle.blindSpotRightClear then
				score = score + CONFIG.BLIND_SPOT_BIAS
			else
				score = score - CONFIG.BLIND_SPOT_BIAS
			end
		end

		if haveLatErr then
			local endLat = curLatErr + math.sin(math.rad(midAngle)) * CONFIG.AVOID_LATERAL_LOOKAHEAD
			local norm = math_abs(endLat) / math_max(roadHalfForPenalty, 0.5)
			local pen = clamp(norm, 0, 2.0)
			score = score - pen * pen * CONFIG.AVOID_LATERAL_PENALTY_WEIGHT
		end

		if angleSticky then
			local proximity = clamp(1 - math_abs(midAngle - stickyAngle) / stickyWidth, 0, 1)
			score = score + proximity * CONFIG.AVOID_ANGLE_STICKY_BONUS
		end

		score = score - occupancyPenaltyForAngle(midAngle, occupancyGrid, occRows, occCols)
		score = score - predictTrackPenalty(midAngle, confirmedTracks, curLatErr)

		return score, midAngle
	end

	local bestScore = -math_huge
	local bestAngle = 0
	local found = false

	for _, c in ipairs(corridors) do
		local sc, ang = corridorScore(c)
		if sc > bestScore then
			bestScore = sc
			bestAngle = ang
			found = true
		end
	end

	if not found then
		local leftSum = 0
		local rightSum = 0

		for _, b in ipairs(beam) do
			local w = clamp(b.clear / CONFIG.LIDAR_RANGE, 0, 1)
			if b.angle < 0 then
				leftSum = leftSum + w
			else
				rightSum = rightSum + w
			end
		end

		local side = 0
		if leftSum > rightSum then
			side = -1
		elseif rightSum > leftSum then
			side = 1
		end

		if side == 0 then
			side = (vehicle.leftPressure <= vehicle.rightPressure) and -1 or 1
		end

		if side < 0 and (not vehicle.blindSpotLeftClear) and vehicle.blindSpotRightClear then
			side = 1
		end
		if side > 0 and (not vehicle.blindSpotRightClear) and vehicle.blindSpotLeftClear then
			side = -1
		end

		if haveLatErr and math_abs(curLatErr) > 1.5 then
			local recenterSide = (curLatErr > 0) and -1 or 1
			local recenterAllowed = (recenterSide < 0 and vehicle.blindSpotLeftClear) or (recenterSide > 0 and vehicle.blindSpotRightClear)
			if recenterAllowed then
				side = recenterSide
			end
		end

		bestAngle = side * (half * 0.65)
		bestScore = 0
	end

	local sideNow = sign(bestAngle)
	local sticky = nowT < vehicle.avoidChosenUntil
	if sticky then
		local oldSide = vehicle.avoidChosenSide
		if oldSide ~= 0 and sideNow ~= 0 and oldSide ~= sideNow then
			if bestScore < (vehicle.avoidChosenScore + CONFIG.AVOID_SWITCH_HYST) then
				bestAngle = vehicle.avoidChosenAngle
				bestScore = vehicle.avoidChosenScore
				sideNow = sign(bestAngle)
			end
		end
	end

	vehicle.avoidChosenAngle = bestAngle
	vehicle.avoidChosenScore = bestScore
	vehicle.avoidChosenSide = sideNow
	vehicle.avoidChosenUntil = nowT + CONFIG.AVOID_STICKY_TIME

	local steer = clamp((bestAngle / half) * CONFIG.MAX_STEER_ANGLE, -CONFIG.AVOID_MAX_STEER, CONFIG.AVOID_MAX_STEER)

	local clusterCount = 0
	local inCluster = false
	for i = 1, n do
		local occ = beam[i].clear < CONFIG.THREAT_ZONE_WARNING
		if occ and not inCluster then
			clusterCount = clusterCount + 1
			inCluster = true
		elseif not occ then
			inCluster = false
		end
	end

	local singleObstacleLike = (clusterCount <= 1) or ((lidarScan.threatCount or 0) <= 5)
	if singleObstacleLike then
		local threatLat = math_abs(lidarScan.threatLateral or 0)
		local lateralNorm = clamp((threatLat - CONFIG.PATH_WIDTH_CENTER) / math_max(CONFIG.PATH_WIDTH_FULL, 1e-6), 0, 1)
		local singleScale = 1.0 - lateralNorm * (1.0 - CONFIG.AVOID_SINGLE_THREAT_MULT)
		steer = steer * singleScale
	end

	if tl >= ThreatLevel.WARNING and math_abs(steer) < CONFIG.AVOID_MIN_STEER then
		local pref = -sign(lidarScan.threatLateral or 0)
		if pref == 0 then
			pref = (vehicle.leftPressure <= vehicle.rightPressure) and -1 or 1
		end
		steer = pref * CONFIG.AVOID_MIN_STEER
	end

	steer = steer + computeYawDampingCorr(steer)

	local edgePen = math_max(vehicle.leftPressure, vehicle.rightPressure)
	local avoidScale = 1.0 - edgePen * 0.7
	steer = steer * clamp(avoidScale, 0.25, 1.0)

	local threatForwardDist = math_min(lidarScan.threatDistance or 24, 24)
	local laneConf = clamp(laneConfidence or 0, 0, 1)
	if tl < ThreatLevel.WARNING and laneConf > 0.35 then
		local blend = clamp(laneConf * 0.75, 0, 1)
		steer = steer * (1 - blend) + laneSteer * blend
		steer = clamp(steer, -CONFIG.AVOID_MAX_STEER, CONFIG.AVOID_MAX_STEER)
	end

	if vehicle.roadBoundsValid then
		local limL = -math.deg(math.atan2(leftSpace, math.max(threatForwardDist * 0.55, 3)))
		local limR = math.deg(math.atan2(rightSpace, math.max(threatForwardDist * 0.55, 3)))
		steer = clamp(steer, limL, limR)
	end

	local blockedMajor = allForwardBlockedMajor(lidarScan)
	vehicle.avoidBlocked = blockedMajor
	vehicle.avoidSteer = smoothLerp(vehicle.avoidSteer, steer, CONFIG.AVOID_STEER_RATE)

	return clamp(vehicle.avoidSteer, -CONFIG.AVOID_MAX_STEER, CONFIG.AVOID_MAX_STEER), blockedMajor
end

--==================================================
-- RETURN CONTROLLER
--==================================================
local function updateReturnOscillation(err)
	local t = now()
	local s = sign(err)

	if s ~= 0 and vehicle.returnLastSign ~= 0 and s ~= vehicle.returnLastSign then
		table.insert(vehicle.returnFlipTimes, t)
	end
	if s ~= 0 then
		vehicle.returnLastSign = s
	end

	local cutoff = t - CONFIG.RETURN_OSC_WINDOW
	while #vehicle.returnFlipTimes > 0 and vehicle.returnFlipTimes[1] < cutoff do
		table.remove(vehicle.returnFlipTimes, 1)
	end
	while #vehicle.returnFlipTimes > CONFIG.RETURN_OSC_FLIP_LIMIT * 4 do
		table.remove(vehicle.returnFlipTimes, 1)
	end

	return #vehicle.returnFlipTimes >= CONFIG.RETURN_OSC_FLIP_LIMIT
end

local function computeEdgeGuardSteer(leftClosest, rightClosest, phase)
	local leftD = leftClosest or math_huge
	local rightD = rightClosest or math_huge
	local steer = 0

	if leftD < CONFIG.EDGE_GUARD_NEAR then
		local k = clamp((CONFIG.EDGE_GUARD_NEAR - leftD) / (CONFIG.EDGE_GUARD_NEAR - CONFIG.EDGE_GUARD_CRITICAL + 1e-6), 0, 1)
		steer = steer + CONFIG.EDGE_GUARD_MAX_STEER * k
	end

	if rightD < CONFIG.EDGE_GUARD_NEAR then
		local k = clamp((CONFIG.EDGE_GUARD_NEAR - rightD) / (CONFIG.EDGE_GUARD_NEAR - CONFIG.EDGE_GUARD_CRITICAL + 1e-6), 0, 1)
		steer = steer - CONFIG.EDGE_GUARD_MAX_STEER * k
	end

	local phaseMult = 1.0
	if phase == AvoidPhase.ACTIVE then
		phaseMult = CONFIG.EDGE_GUARD_ACTIVE_WEIGHT
	elseif phase == AvoidPhase.RETURN then
		phaseMult = CONFIG.EDGE_GUARD_RETURN_WEIGHT
	end

	steer = steer * phaseMult
	return clamp(steer, -CONFIG.EDGE_GUARD_MAX_STEER, CONFIG.EDGE_GUARD_MAX_STEER)
end

local function computeReturnToLaneSteer(cuScan, dt)
	local rawError = estimateLateralError(cuScan)
	vehicle.returnFilteredError = ema(vehicle.returnFilteredError, rawError, CONFIG.RETURN_ERROR_FILTER_ALPHA)
	local err = vehicle.returnFilteredError

	local rawDeriv = 0
	if dt > 0 then
		rawDeriv = (err - vehicle.returnPrevError) / dt
	end
	vehicle.returnPrevError = err
	vehicle.returnFilteredDeriv = ema(vehicle.returnFilteredDeriv, rawDeriv, CONFIG.RETURN_DERIV_FILTER_ALPHA)

	local steer = -(CONFIG.RETURN_KP * err + CONFIG.RETURN_KD * vehicle.returnFilteredDeriv)
	local absError = math_abs(err)

	local dynMax = CONFIG.RETURN_NEAR_STEER_MAX
		+ (CONFIG.RETURN_MAX_STEER - CONFIG.RETURN_NEAR_STEER_MAX)
		* clamp(absError / math_max(CONFIG.RETURN_FULL_ERROR_FOR_MAX, 0.1), 0, 1)

	steer = clamp(steer, -dynMax, dynMax)

	if absError < CONFIG.RETURN_CENTER_SOFT_ZONE then
		local k = clamp(absError / CONFIG.RETURN_CENTER_SOFT_ZONE, 0, 1)
		steer = steer * (0.25 + 0.75 * k)
	end

	if vehicle.returnLockSign ~= 0 then
		local cmdSign = sign(steer)
		local canRelease = (now() >= vehicle.returnLockUntil) and (absError <= CONFIG.RETURN_LOCK_RELEASE_ERROR)
		if canRelease then
			vehicle.returnLockSign = 0
		elseif cmdSign ~= 0 and cmdSign ~= vehicle.returnLockSign then
			steer = vehicle.returnLockSign * math_min(math_abs(steer), CONFIG.RETURN_NEAR_STEER_MAX)
		end
	end

	if primary and primary.Parent then
		local yawRate = math_abs(math_deg(primary.AssemblyAngularVelocity.Y))
		local desiredYaw = math_abs(steer) * 0.70
		if yawRate > desiredYaw then
			local damp = clamp((yawRate - desiredYaw) * CONFIG.RETURN_YAW_DAMP_GAIN, 0, CONFIG.RETURN_YAW_MAX_DAMP)
			steer = steer - sign(steer) * damp
		end
	end

	local returnOsc = updateReturnOscillation(err)
	if returnOsc then
		steer = steer * CONFIG.RETURN_OSC_DAMP
	end

	vehicle.returnSmoothedSteer = smoothLerp(vehicle.returnSmoothedSteer, steer, 0.34)
	return vehicle.returnSmoothedSteer, absError, err, returnOsc
end

local function beginReturnPhase(t, cuScan)
	vehicle.avoidPhase = AvoidPhase.RETURN
	vehicle.returnStartT = t
	vehicle.returnSettledT = 0
	vehicle.returnCenterStableT = 0
	vehicle.returnSmoothedSteer = 0
	vehicle.returnBlendStart = t
	vehicle.returnEntrySteer = 0

	local lateralErr = estimateLateralError(cuScan)
	vehicle.returnFilteredError = lateralErr
	vehicle.returnPrevError = lateralErr
	vehicle.returnFilteredDeriv = 0
	vehicle.returnFlipTimes = {}
	vehicle.returnLastSign = 0

	local avgSteer = (vehicle.avoidActiveT > 1e-3) and (vehicle.avoidSteerAccum / vehicle.avoidActiveT) or vehicle.avoidSteerEma
	local debtFromAvg = -avgSteer * CONFIG.AVOID_DEBT_GAIN
	local debtFromIntegral = -vehicle.avoidSteerAccum * (CONFIG.AVOID_DEBT_GAIN * 0.45)
	local debtFromError = -lateralErr * 0.45
	local debt = debtFromAvg + debtFromIntegral + debtFromError

	if math_abs(debt) < 1.0 and lateralErr ~= 0 then
		debt = -lateralErr * 1.25
	end

	vehicle.returnDebt = clamp(debt, -CONFIG.AVOID_DEBT_MAX, CONFIG.AVOID_DEBT_MAX)

	local lockSign = sign(vehicle.returnDebt)
	if lockSign == 0 then
		lockSign = sign(-(CONFIG.RETURN_KP * lateralErr))
	end
	vehicle.returnLockSign = lockSign
	vehicle.returnLockUntil = t + CONFIG.RETURN_LOCK_MIN_TIME

	vehicle.avoidSteerAccum = 0
	vehicle.avoidActiveT = 0
	vehicle.avoidSteerEma = 0
	vehicle.avoidSteerPeak = 0
	vehicle.recenterImpulse = 0
	vehicle.recenterSign = 0
	vehicle.avoidSteer = 0
	vehicle.avoidDirection = 0
	vehicle.avoidBlocked = false
end

--==================================================
-- PEDESTRIAN / HEADING / STUCK / NARROW
--==================================================
local function updatePedestrianTracker(lidarScan, dt)
	if lidarScan.pedValid and (lidarScan.pedDist or math_huge) < math_huge then
		vehicle.pedSeen = true
		vehicle.pedLastSeenT = now()

		local dist = lidarScan.pedDist
		local ang = lidarScan.pedClosestAngle or 0
		local moving = false

		if vehicle.pedPrevValid and dt > 0 then
			if math_abs(dist - vehicle.pedPrevDist) / dt >= CONFIG.PED_MOVE_DIST_RATE
				or math_abs(wrapDeg(ang - vehicle.pedPrevAngle)) / dt >= CONFIG.PED_MOVE_ANGLE_RATE then
				moving = true
			end
		end

		vehicle.pedPrevDist = dist
		vehicle.pedPrevAngle = ang
		vehicle.pedPrevValid = true

		if moving then
			vehicle.pedStationaryTime = 0
		else
			vehicle.pedStationaryTime = math_min(vehicle.pedStationaryTime + dt, 10)
		end

		if dist <= CONFIG.PED_YIELD_DIST and vehicle.pedStationaryTime < CONFIG.PED_STATIONARY_TIME then
			return true, false
		end
		if dist <= CONFIG.PED_AVOID_MAX_DIST and vehicle.pedStationaryTime >= CONFIG.PED_STATIONARY_TIME then
			return false, true
		end
		return false, false
	end

	vehicle.pedSeen = false
	vehicle.pedPrevValid = false
	vehicle.pedStationaryTime = 0
	return false, false
end

local function pedIsClear(lidarScan)
	return vehicle.pedAvoidActive and (lidarScan.pedLastSeenAge or 999) >= CONFIG.PED_CLEAR_TIME
end

local function updatePedAvoidSteer(lidarScan)
	local hits = lidarScan.pedHitCount or 0
	vehicle.pedPeakHits = math_max(vehicle.pedPeakHits, hits)

	local s = sign(lidarScan.pedAngleMean or 0)
	if s == 0 then
		s = sign(lidarScan.pedClosestAngle or 0)
	end
	if s ~= 0 then
		vehicle.pedSide = s
	end

	local avoidDir = -vehicle.pedSide
	if avoidDir == 0 then
		avoidDir = 1
	end

	local hitNorm = clamp(hits / 10, 0, 1)
	local edgeRisk = clamp((vehicle.leftPressure + vehicle.rightPressure) * 0.5, 0, 1)

	local cap = clamp(
		CONFIG.PED_AVOID_BASE_CAP
			+ (hitNorm * CONFIG.PED_AVOID_HIT_SCALE * (CONFIG.PED_AVOID_MAX_CAP - CONFIG.PED_AVOID_BASE_CAP))
			* (1 - edgeRisk * CONFIG.PED_AVOID_PRESSURE_SHRINK),
		3,
		CONFIG.PED_AVOID_MAX_CAP
	)

	local mag = cap
	local pressureDir = 0
	if vehicle.leftPressure > vehicle.rightPressure then
		pressureDir = -1
	elseif vehicle.rightPressure > vehicle.leftPressure then
		pressureDir = 1
	end

	if pressureDir ~= 0 and avoidDir == pressureDir then
		mag = mag * (1 - CONFIG.PED_SECTOR_EDGE_PENALTY)
	end

	vehicle.pedAvoidSteer = smoothLerp(vehicle.pedAvoidSteer, avoidDir * mag, CONFIG.PED_AVOID_BLEND_ALPHA)
	return vehicle.pedAvoidSteer
end

local function armHeadingHold()
	if headingPart and headingPart.Parent then
		vehicle.headingHoldYaw = getYawDeg(headingPart.CFrame)
		vehicle.headingHoldUntil = now() + CONFIG.HEADING_HOLD_TIME
		vehicle.prevYawValid = false
	end
end

local function headingHoldSteer(dt)
	if now() >= vehicle.headingHoldUntil then
		return 0
	end
	if not headingPart or not headingPart.Parent then
		return 0
	end

	local yaw = getYawDeg(headingPart.CFrame)
	local yawRate = 0

	if vehicle.prevYawValid and dt > 0 then
		yawRate = wrapDeg(yaw - vehicle.prevYaw) / dt
	end

	vehicle.prevYaw = yaw
	vehicle.prevYawValid = true

	local steer = clamp(
		(CONFIG.HEADING_KP * wrapDeg(vehicle.headingHoldYaw - yaw)) + (CONFIG.HEADING_KD * (-yawRate)),
		-CONFIG.HEADING_MAX_CORR,
		CONFIG.HEADING_MAX_CORR
	)

	if CONFIG.HEADING_DECAY then
		steer = steer * clamp((vehicle.headingHoldUntil - now()) / CONFIG.HEADING_HOLD_TIME, 0, 1)
	end

	return steer
end

local function updateNarrowPassageMult(cuScan)
	if not cuScan or not cuScan.valid then
		vehicle.narrowSpeedMult = 1.0
		return
	end

	local l = cuScan.leftDist < math_huge and cuScan.leftDist or 0
	local r = cuScan.rightDist < math_huge and cuScan.rightDist or 0
	if l <= 0 or r <= 0 then
		vehicle.narrowSpeedMult = 1.0
		return
	end

	local totalWidth = l + r
	if totalWidth >= CONFIG.NARROW_PASSAGE_WIDTH then
		vehicle.narrowSpeedMult = 1.0
	elseif totalWidth >= CONFIG.NARROW_PASSAGE_WIDTH_CRITICAL then
		local frac = (CONFIG.NARROW_PASSAGE_WIDTH - totalWidth)
			/ math_max(CONFIG.NARROW_PASSAGE_WIDTH - CONFIG.NARROW_PASSAGE_WIDTH_CRITICAL, 0.1)
		vehicle.narrowSpeedMult = 1.0 + (CONFIG.NARROW_SPEED_MULT - 1.0) * clamp(frac, 0, 1)
	else
		vehicle.narrowSpeedMult = CONFIG.NARROW_SPEED_MULT_CRITICAL
	end
end

local function updateStuckDetect(dt, t)
	if vehicle.stuckEscapeActive then
		if t < vehicle.stuckEscapeUntil then
			return true
		end
		vehicle.stuckEscapeActive = false
		vehicle.stuckTimer = 0
		return false
	end

	if vehicle.avoidPhase == AvoidPhase.EMERGENCY_STOP or vehicle.avoidPhase == AvoidPhase.EMERGENCY_REVERSE then
		vehicle.stuckTimer = 0
		return false
	end

	if vehicle.speedTarget < CONFIG.STUCK_MIN_SPEED_CMD then
		vehicle.stuckTimer = math_max(0, vehicle.stuckTimer - dt * 0.5)
		return false
	end

	if not primary or not primary.Parent then
		return false
	end

	local hs = horizontalSpeed(primary.AssemblyLinearVelocity)
	if hs < CONFIG.STUCK_VELOCITY_THRESHOLD then
		vehicle.stuckTimer = vehicle.stuckTimer + dt
		if vehicle.stuckTimer >= CONFIG.STUCK_TIME_TRIGGER then
			vehicle.stuckEscapeActive = true
			vehicle.stuckEscapeUntil = t + CONFIG.STUCK_ESCAPE_TIME
			vehicle.stuckTimer = 0
			return true
		end
	else
		vehicle.stuckTimer = math_max(0, vehicle.stuckTimer - dt * 0.8)
	end

	return false
end

--==================================================
-- SPEED / FUSION
--==================================================
local function fuseSensorInputs(laneSteer, pressureSteer, avoidSteer, threatLevel, laneConfidence)
	laneConfidence = clamp(laneConfidence or 0, 0, 1)

	local laneW, obsW, pressureW
	if threatLevel == ThreatLevel.CRITICAL then
		laneW = 0.22
		obsW = 1.0
		pressureW = 0.25
	elseif threatLevel == ThreatLevel.WARNING then
		laneW = 0.35
		obsW = 0.92
		pressureW = 0.30
	elseif threatLevel == ThreatLevel.CAUTION then
		laneW = 0.55
		obsW = 0.62
		pressureW = 0.35
	elseif threatLevel == ThreatLevel.MONITOR then
		laneW = 0.85
		obsW = 0.25
		pressureW = 0.30
	else
		laneW = 1.0
		obsW = 0.0
		pressureW = 0.40
	end

	laneW = laneW * (0.35 + 0.65 * laneConfidence)

	if vehicle.avoidPhase == AvoidPhase.ACTIVE then
		if threatLevel >= ThreatLevel.CRITICAL then
			laneW = laneW * 0.25
		elseif threatLevel >= ThreatLevel.WARNING then
			laneW = laneW * 0.40
		else
			laneW = laneW * 0.58
		end
	end

	if math_abs(avoidSteer) >= 6 and math_abs(laneSteer) >= 3 and sign(avoidSteer) ~= sign(laneSteer) then
		laneW = laneW * 0.35
	end
	if math_abs(avoidSteer) >= 10 and math_abs(pressureSteer) >= 5 and sign(avoidSteer) ~= sign(pressureSteer) then
		pressureW = pressureW * 0.50
	end

	local tw = laneW + obsW + pressureW
	if tw <= 0 then
		return 0
	end

	return clamp((laneSteer * laneW + avoidSteer * obsW + pressureSteer * pressureW) / tw, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
end

local function computeTargetSpeed(lidarScan, threatLevel, curveFactor, plannedSteer)
	local baseSpeed = CONFIG.NORMAL_SPEED
	curveFactor = clamp(curveFactor, 0, 1)

	if threatLevel == ThreatLevel.CRITICAL then
		baseSpeed = baseSpeed * CONFIG.SPEED_THREAT_MULT_CRITICAL
	elseif threatLevel == ThreatLevel.WARNING then
		baseSpeed = baseSpeed * CONFIG.SPEED_THREAT_MULT_WARNING
	elseif threatLevel == ThreatLevel.CAUTION then
		baseSpeed = baseSpeed * CONFIG.SPEED_THREAT_MULT_CAUTION
	end

	baseSpeed = baseSpeed * (1 - (curveFactor * (CONFIG.CURVE_SPEED_REDUCTION or 0)))

	if lidarScan.leadValid and (lidarScan.leadDist or math_huge) < CONFIG.THREAT_ZONE_MONITOR then
		local leadDist = lidarScan.leadDist or math_huge
		local closingVel = lidarScan.leadClosingVel or 0

		local desiredGap = CONFIG.LEAD_MIN_GAP + math_max(vehicle.speedCurrent, 0) * CONFIG.LEAD_FOLLOW_TIME * 0.25

		if leadDist < desiredGap then
			local gapScale = clamp(leadDist / math_max(desiredGap, 0.1), 0, 1)
			baseSpeed = math_min(baseSpeed, CONFIG.NORMAL_SPEED * gapScale)
		end

		if closingVel > CONFIG.LEAD_CLOSING_EPS then
			local ttc = leadDist / math_max(closingVel, 0.01)
			if ttc < 4.0 then
				baseSpeed = baseSpeed * clamp(ttc / 4.0, 0.2, 1.0)
			end
		end
	end

	baseSpeed = baseSpeed * vehicle.densitySpeedMult
	if vehicle.roadRecoveryActive then
		baseSpeed = baseSpeed * CONFIG.ROAD_RECOVERY_SPEED_MULT
	end

	baseSpeed = baseSpeed * vehicle.narrowSpeedMult
	baseSpeed = baseSpeed * getSlowZoneMult()

	if now() < vehicle.stopZoneUntil then
		return 0
	end

	if vehicle.avoidBlocked and vehicle.avoidPhase == AvoidPhase.ACTIVE then
		return 0
	end

	if vehicle.avoidPhase == AvoidPhase.ACTIVE and baseSpeed > 0 then
		baseSpeed = math_max(baseSpeed, CONFIG.AVOID_SPEED_MIN)
	end

	if vehicle.avoidPhase == AvoidPhase.RETURN then
		baseSpeed = baseSpeed * CONFIG.RETURN_SPEED_MULT
	end

	if vehicle.aebActive then
		return 0
	end

	return baseSpeed * (1 - (math_abs(plannedSteer) / CONFIG.MAX_STEER_ANGLE * CONFIG.SPEED_STEER_SLOW))
end

--==================================================
-- EMERGENCY
--==================================================
local function enterEmergencyStop(t)
	vehicle.avoidPhase = AvoidPhase.EMERGENCY_STOP
	vehicle.emergencyStopUntil = t + CONFIG.EMERG_HOLD_STOP_TIME
	vehicle.avoidBlocked = true
end

local function enterEmergencyReverse(t)
	vehicle.avoidPhase = AvoidPhase.EMERGENCY_REVERSE
	vehicle.emergencyReverseUntil = t + CONFIG.EMERG_REVERSE_TIME
	vehicle.emergencyChain = vehicle.emergencyChain + 1
end

local function exitEmergency(t, lidarScan, cuScan)
	vehicle.emergencyCooldownUntil = t + CONFIG.EMERG_RECOVERY_COOLDOWN
	vehicle.avoidBlocked = false

	if (lidarScan.maxThreatLevel or ThreatLevel.NONE) >= ThreatLevel.CAUTION then
		vehicle.avoidPhase = AvoidPhase.ACTIVE
	else
		beginReturnPhase(t, cuScan)
	end
end

--==================================================
-- SENSOR INSTANCES
--==================================================
local leftSensor = LaneSensor.new(sensorL)
local rightSensor = LaneSensor.new(sensorR)
lidar = Lidar.new(sensorC)
local centerLane = sensorCU and CenterLaneSensor.new(sensorCU) or nil

--==================================================
-- MAIN LOOP
--==================================================
local heartbeatConnection
local lastDebugPrint = 0

heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
	local t = now()
	vehicle.frameCount = vehicle.frameCount + 1
	vehicle.avgFrameTime = ema(vehicle.avgFrameTime, dt, 0.1)

	if not primary or not primary.Parent then
		return
	end

	updateVelocityYaw()
	updateStopZones(t)

	local leftScan = leftSensor:scan()
	local rightScan = rightSensor:scan()
	local lidarScan = lidar:scan(dt)
	local cuScan = centerLane and centerLane:scan() or {
		valid = false,
		lateralError = 0,
		leftDist = math_huge,
		rightDist = math_huge,
		confidence = 0,
		leftDetected = false,
		rightDetected = false,
	}

	updateRayDensity(lidar)
	updateNarrowPassageMult(cuScan)
	checkAEB(lidarScan)

	local detections = extractTrackDetections(lidar, sensorC)
	updateTracks(detections, dt)

	local yawRateDeg = math_abs(math_deg(primary.AssemblyAngularVelocity.Y))
	local curveFactor0 = clamp(yawRateDeg / (CONFIG.CURVE_YAWRATE_DEG or 18.0), 0, 1)

	vehicle.maxThreatLevel = lidarScan.maxThreatLevel
	vehicle.threatScore = ema(vehicle.threatScore, lidarScan.maxThreatScore, 0.3)
	vehicle.threatDistance = lidarScan.threatDistance
	vehicle.threatLateral = lidarScan.threatLateral
	vehicle.threatForward = lidarScan.threatForward
	vehicle.speedTarget = vehicle.speedCurrent

	local maxPressure = math_max(vehicle.leftPressure, vehicle.rightPressure)
	if maxPressure > CONFIG.ROAD_RECOVERY_PRESSURE then
		vehicle.roadRecoveryT = vehicle.roadRecoveryT + dt
	else
		vehicle.roadRecoveryT = math_max(0, vehicle.roadRecoveryT - dt * 1.2)
	end
	vehicle.roadRecoveryActive = vehicle.roadRecoveryT >= CONFIG.ROAD_RECOVERY_MIN_TIME

	if vehicle.avoidPhase ~= AvoidPhase.EMERGENCY_STOP and vehicle.avoidPhase ~= AvoidPhase.EMERGENCY_REVERSE then
		if updateStuckDetect(dt, t) then
			applySpeedRaw(CONFIG.EMERG_REVERSE_SPEED * 0.8)
			applySteering(0, CONFIG.EMERG_STEER_CENTER_RATE)
			return
		end
	end

	if vehicle.avoidPhase == AvoidPhase.ACTIVE then
		updateBlindSpots()
	else
		vehicle.blindSpotLeftClear = true
		vehicle.blindSpotRightClear = true
	end

	local pedYield, pedAvoid = updatePedestrianTracker(lidarScan, dt)
	if pedYield then
		local cuSteer, cuConfidence = computeCenterLaneSteer(cuScan, dt)
		local edgeSteer, nL, nR = computeEdgeLaneSteer(leftScan, rightScan, curveFactor0)
		local laneSteer = select(1, computeCombinedLaneSteer(cuSteer, cuConfidence, edgeSteer, nL, nR))
		local pressureSteer = updateLanePressure(leftScan.closest, rightScan.closest, dt)
		local wpSteer, hasWP = computeWaypointSteer()
		local final = laneSteer + pressureSteer
		if hasWP and vehicle.maxThreatLevel <= ThreatLevel.MONITOR then
			final = clamp(final * 0.7 + wpSteer * 0.3, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
		end

		applySteering(final, CONFIG.STEERING_RATE)
		applySpeedSmooth(0, dt)
		return
	end

	if pedAvoid then
		if not vehicle.pedAvoidActive then
			vehicle.pedAvoidActive = true
			vehicle.pedPeakHits = 0
			vehicle.pedAvoidSteer = 0
			vehicle.pedSide = 0
		end

		local pedSteer = updatePedAvoidSteer(lidarScan)
		local cuSteer, cuConfidence = computeCenterLaneSteer(cuScan, dt)
		local edgeSteer, nL, nR = computeEdgeLaneSteer(leftScan, rightScan, curveFactor0)
		local laneSteer = select(1, computeCombinedLaneSteer(cuSteer, cuConfidence, edgeSteer, nL, nR))
		local pressureSteer = updateLanePressure(leftScan.closest, rightScan.closest, dt)

		applySteering(clamp(laneSteer + pressureSteer + pedSteer, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE), CONFIG.STEERING_RATE_FAST)
		applySpeedSmooth(CONFIG.NORMAL_SPEED * 0.6, dt)
		return
	end

	if vehicle.pedAvoidActive and pedIsClear(lidarScan) then
		vehicle.pedAvoidActive = false
		vehicle.pedSlowUntil = t + CONFIG.PED_POST_AVOID_SLOW_TIME
		vehicle.pedAvoidSteer = 0
		armHeadingHold()
	end

	local cuSteer, cuConfidence = computeCenterLaneSteer(cuScan, dt)
	local edgeSteer, normLeft, normRight = computeEdgeLaneSteer(leftScan, rightScan, curveFactor0)
	local laneSteer, laneConfidence = computeCombinedLaneSteer(cuSteer, cuConfidence, edgeSteer, normLeft, normRight)

	local wpSteer, hasWP = computeWaypointSteer()
	if hasWP and vehicle.maxThreatLevel <= ThreatLevel.MONITOR then
		laneSteer = clamp(laneSteer * 0.75 + wpSteer * 0.25, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
	end

	local curveFactor = clamp(math_max(curveFactor0, math_abs(laneSteer) / (CONFIG.CURVE_STEER_DEG or 18)), 0, 1)
	local pressureSteer = updateLanePressure(leftScan.closest, rightScan.closest, dt)
	local edgeGuard = computeEdgeGuardSteer(leftScan.closest, rightScan.closest, vehicle.avoidPhase)

	if vehicle.avoidPhase ~= AvoidPhase.EMERGENCY_STOP and vehicle.avoidPhase ~= AvoidPhase.EMERGENCY_REVERSE and t >= vehicle.emergencyCooldownUntil then
		if allForwardBlockedMajor(lidarScan) then
			enterEmergencyStop(t)
		end
	end

	local finalSteer = 0
	local steerRate = CONFIG.STEERING_RATE
	local targetSpeed = 0

	if vehicle.avoidPhase == AvoidPhase.NONE then
		vehicle.recenterImpulse = 0
		vehicle.recenterSign = 0
		vehicle.avoidSteerAccum = 0
		vehicle.avoidActiveT = 0
		vehicle.avoidSteerEma = 0
		vehicle.avoidSteerPeak = 0
		vehicle.returnDebt = 0
		vehicle.returnLockSign = 0
		vehicle.returnCenterStableT = 0
		vehicle.returnFilteredError = 0
		vehicle.returnFilteredDeriv = 0
		vehicle.returnFlipTimes = {}
		vehicle.returnLastSign = 0

		if t >= vehicle.avoidCooldownUntil and vehicle.maxThreatLevel >= ThreatLevel.CAUTION then
			vehicle.avoidPhase = AvoidPhase.ACTIVE
		end

		if vehicle.avoidPhase == AvoidPhase.NONE then
			local avoidSteer = select(1, computeAvoidanceSteer(lidarScan, laneSteer, pressureSteer, laneConfidence, dt, cuScan))
			finalSteer = fuseSensorInputs(laneSteer, pressureSteer, avoidSteer, vehicle.maxThreatLevel, laneConfidence)

			local headingCorr = headingHoldSteer(dt)
			if headingCorr ~= 0 then
				finalSteer = clamp(finalSteer + headingCorr, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
			end

			targetSpeed = computeTargetSpeed(lidarScan, vehicle.maxThreatLevel, curveFactor, finalSteer)
		end
	end

	if vehicle.avoidPhase == AvoidPhase.ACTIVE then
		local avoidSteer, blockedAll = computeAvoidanceSteer(lidarScan, laneSteer, pressureSteer, laneConfidence, dt, cuScan)
		finalSteer = fuseSensorInputs(laneSteer, pressureSteer, avoidSteer, vehicle.maxThreatLevel, laneConfidence)

		if vehicle.maxThreatLevel <= ThreatLevel.CAUTION then
			local activeErr = estimateLateralError(cuScan)
			local recenterAssist = clamp(-activeErr * CONFIG.ACTIVE_RECENTER_GAIN, -CONFIG.ACTIVE_RECENTER_MAX, CONFIG.ACTIVE_RECENTER_MAX)
			finalSteer = finalSteer + recenterAssist
		end

		finalSteer = clamp(finalSteer + edgeGuard, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)

		vehicle.avoidSteerAccum = vehicle.avoidSteerAccum + avoidSteer * dt
		vehicle.avoidActiveT = vehicle.avoidActiveT + dt
		vehicle.avoidSteerEma = ema(vehicle.avoidSteerEma, avoidSteer, 0.18)
		vehicle.avoidSteerPeak = math_max(vehicle.avoidSteerPeak, math_abs(avoidSteer))
		vehicle.recenterImpulse = 0
		vehicle.recenterSign = sign(avoidSteer)

		steerRate = CONFIG.STEERING_RATE_FAST
		targetSpeed = computeTargetSpeed(lidarScan, vehicle.maxThreatLevel, curveFactor, finalSteer)
		if vehicle.roadRecoveryActive then
			targetSpeed = targetSpeed * CONFIG.ROAD_RECOVERY_SPEED_MULT
		end

		if blockedAll and t >= vehicle.emergencyCooldownUntil then
			enterEmergencyStop(t)
			finalSteer = 0
			steerRate = CONFIG.EMERG_STEER_CENTER_RATE
			targetSpeed = 0
		else
			if vehicle.threatScore < CONFIG.AVOID_CLEAR_THRESHOLD and vehicle.maxThreatLevel < ThreatLevel.CAUTION then
				beginReturnPhase(t, cuScan)
			end
		end
	end

	if vehicle.avoidPhase == AvoidPhase.RETURN then
		local returnSteer, absError, _, returnOsc = computeReturnToLaneSteer(cuScan, dt)

		local nearNorm = clamp(1 - (absError / math_max(CONFIG.RETURN_FULL_ERROR_FOR_MAX, 0.1)), 0, 1)
		local debtDecay = CONFIG.AVOID_DEBT_DECAY + CONFIG.RETURN_DEBT_DECAY_NEAR * nearNorm
		vehicle.returnDebt = vehicle.returnDebt * math_max(0, 1 - debtDecay * dt)

		if sign(vehicle.returnDebt) ~= 0 and sign(returnSteer) ~= 0 and sign(vehicle.returnDebt) ~= sign(returnSteer) and absError < CONFIG.RETURN_FULL_ERROR_FOR_MAX then
			vehicle.returnDebt = vehicle.returnDebt * math_max(0, 1 - CONFIG.RETURN_DEBT_DECAY_NEAR * 1.6 * dt)
		end
		if returnOsc then
			vehicle.returnDebt = vehicle.returnDebt * math_max(0, 1 - CONFIG.RETURN_DEBT_DECAY_NEAR * 1.9 * dt)
		end

		local debtWeight = clamp(absError / math_max(CONFIG.RETURN_FULL_ERROR_FOR_MAX, 0.1), 0.25, 1.0)
		local debtSteer = vehicle.returnDebt * debtWeight

		local edgeBlendT = clamp(absError / math_max(CONFIG.RETURN_FULL_ERROR_FOR_MAX, 0.1), 0, 1)
		local edgeBlend = CONFIG.RETURN_EDGE_BLEND_NEAR + (CONFIG.RETURN_EDGE_BLEND_FAR - CONFIG.RETURN_EDGE_BLEND_NEAR) * edgeBlendT
		local edgeReturn = edgeGuard * edgeBlend
		if returnOsc then
			edgeReturn = edgeReturn * 0.65
		end

		finalSteer = clamp(returnSteer + debtSteer + edgeReturn, -CONFIG.MAX_STEER_ANGLE, CONFIG.MAX_STEER_ANGLE)
		steerRate = CONFIG.STEERING_RATE_FAST
		targetSpeed = computeTargetSpeed(lidarScan, vehicle.maxThreatLevel, curveFactor, finalSteer)
		if returnOsc then
			targetSpeed = targetSpeed * CONFIG.RETURN_OSC_SPEED_MULT
		end

		local nearCenter = absError < CONFIG.RETURN_SETTLED_THRESHOLD
		local lowDebt = math_abs(vehicle.returnDebt) < 1.1
		local lowDeriv = math_abs(vehicle.returnFilteredDeriv) < 1.0

		if nearCenter and lowDebt and lowDeriv and (not returnOsc) then
			if vehicle.returnCenterStableT == 0 then
				vehicle.returnCenterStableT = t
			end

			if (t - vehicle.returnCenterStableT) >= CONFIG.RETURN_SETTLED_TIME then
				vehicle.avoidPhase = AvoidPhase.NONE
				vehicle.avoidCooldownUntil = t + CONFIG.AVOID_SESSION_COOLDOWN
				vehicle.recenterImpulse = 0
				vehicle.recenterSign = 0
				vehicle.returnPrevError = 0
				vehicle.returnDebt = 0
				vehicle.returnLockSign = 0
				vehicle.avoidSteerAccum = 0
				vehicle.avoidActiveT = 0
				vehicle.avoidSteerEma = 0
				vehicle.avoidSteerPeak = 0
				armHeadingHold()
			end
		else
			vehicle.returnCenterStableT = 0
		end

		if (t - vehicle.returnStartT) >= CONFIG.RETURN_MAX_DURATION then
			vehicle.avoidPhase = AvoidPhase.NONE
			vehicle.avoidCooldownUntil = t + CONFIG.AVOID_SESSION_COOLDOWN
			vehicle.recenterImpulse = 0
			vehicle.recenterSign = 0
			vehicle.returnPrevError = 0
			vehicle.returnDebt = 0
			vehicle.returnLockSign = 0
			vehicle.avoidSteerAccum = 0
			vehicle.avoidActiveT = 0
			vehicle.avoidSteerEma = 0
			vehicle.avoidSteerPeak = 0
			armHeadingHold()
		end

		if vehicle.maxThreatLevel >= ThreatLevel.CAUTION then
			vehicle.avoidPhase = AvoidPhase.ACTIVE
			vehicle.returnLockSign = 0
		end
	end

	if vehicle.avoidPhase == AvoidPhase.EMERGENCY_STOP then
		finalSteer = smoothLerp(vehicle.currentSteer, 0, CONFIG.EMERG_STEER_CENTER_RATE)
		steerRate = CONFIG.EMERG_STEER_CENTER_RATE
		targetSpeed = 0

		applySteering(finalSteer, steerRate)
		applySpeedSmooth(0, dt)

		if t >= vehicle.emergencyStopUntil then
			if vehicle.emergencyChain < CONFIG.EMERG_MAX_CHAINS then
				enterEmergencyReverse(t)
			else
				if not allForwardBlockedMajor(lidarScan) then
					vehicle.emergencyChain = 0
					exitEmergency(t, lidarScan, cuScan)
				end
			end
		end
		return
	end

	if vehicle.avoidPhase == AvoidPhase.EMERGENCY_REVERSE then
		finalSteer = smoothLerp(vehicle.currentSteer, 0, CONFIG.EMERG_STEER_CENTER_RATE)
		applySteering(finalSteer, CONFIG.EMERG_STEER_CENTER_RATE)
		applySpeedRaw(CONFIG.EMERG_REVERSE_SPEED)

		if not allForwardBlockedMajor(lidarScan) then
			vehicle.emergencyChain = 0
			exitEmergency(t, lidarScan, cuScan)
			return
		end

		if t >= vehicle.emergencyReverseUntil then
			if allForwardBlockedMajor(lidarScan) then
				enterEmergencyStop(t)
			else
				vehicle.emergencyChain = 0
				exitEmergency(t, lidarScan, cuScan)
			end
		end
		return
	end

	vehicle.speedTarget = targetSpeed
	applySteering(finalSteer, steerRate)
	applySpeedSmooth(targetSpeed, dt)

	if CONFIG.DEBUG_PRINT and (t - lastDebugPrint) > 1.0 then
		local phaseName = "NONE"
		if vehicle.avoidPhase == AvoidPhase.ACTIVE then phaseName = "ACTIVE" end
		if vehicle.avoidPhase == AvoidPhase.RETURN then phaseName = "RETURN" end
		if vehicle.avoidPhase == AvoidPhase.EMERGENCY_STOP then phaseName = "EMERGENCY_STOP" end
		if vehicle.avoidPhase == AvoidPhase.EMERGENCY_REVERSE then phaseName = "EMERGENCY_REVERSE" end

		local roadStr = vehicle.roadBoundsValid and string.format("L=%.1f R=%.1f", vehicle.roadLeftDist, vehicle.roadRightDist) or "??"
		local trackCount = #getConfirmedTracks()
		local aebStr = vehicle.aebActive and " AEB" or ""
		local narrowStr = vehicle.narrowSpeedMult < 0.99 and string.format(" Narrow:%.2f", vehicle.narrowSpeedMult) or ""
		local stuckStr = vehicle.stuckTimer > 0.5 and string.format(" Stuck:%.1fs", vehicle.stuckTimer) or ""
		local wpStr = hasWP and (" WP:" .. tostring(currentWaypointIndex)) or ""

		print(string.format(
			"🚗 Phase:%s | Road:%s | Threat:%s(%.2f) | Tracks:%d | DensBlk:%.2f | Steer:%.1f | Spd:%.1f%s%s%s%s",
			phaseName,
			roadStr,
			ThreatLevelNames[vehicle.maxThreatLevel],
			vehicle.threatScore,
			trackCount,
			vehicle.densityBlocked,
			finalSteer,
			vehicle.speedCurrent,
			aebStr,
			narrowStr,
			stuckStr,
			wpStr
			))
		lastDebugPrint = t
	end
end)

